{
  "name": "trader-improvement-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx src/scripts/run-trader-intelligence-local-server.ts --dev --hostname 127.0.0.1",
    "build": "npm run validate:academy-registry && next build",
    "build:webpack": "npm run validate:academy-registry && next build --webpack",
    "deploy:prod": "node scripts/guard-production-deploy.cjs",
    "deploy:prod:check": "node scripts/guard-production-deploy.cjs --preflight-only",
    "start": "tsx src/scripts/run-trader-intelligence-local-server.ts --hostname 127.0.0.1",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "test:e2e:level-analysis": "npm run build && playwright test --config=playwright.level-analysis.config.ts",
    "test:watch": "vitest",
    "audit:market-structure": "tsx src/scripts/audit-experimental-market-structure.ts",
    "calibrate:market-structure": "tsx src/scripts/audit-experimental-market-structure.ts --out-dir artifacts/market-structure-calibration",
    "debug:trade-analysis": "tsx src/scripts/debug-trade-analysis-request.ts",
    "compare:trade-debug": "tsx src/scripts/compare-trade-analysis-debug-runs.ts",
    "compare:levels-system": "tsx src/scripts/compare-levels-system-support-resistance.ts",
    "calibrate:decision-review": "tsx src/scripts/run-decision-review-quality-dashboard.ts",
    "build:ibkr-backfill-manifest": "tsx src/scripts/build-ibkr-warehouse-backfill-manifest.ts",
    "summarize:market-data-readiness": "tsx src/scripts/summarize-market-data-readiness.ts",
    "compare:decision-review-calibrations": "tsx src/scripts/compare-decision-review-calibrations.ts",
    "summarize:session-time-readiness": "tsx src/scripts/summarize-session-time-readiness.ts",
    "summarize:real-data-calibration-public": "tsx src/scripts/summarize-real-data-calibration-public.ts",
    "calibrate:saved-import": "tsx src/scripts/run-saved-import-calibration.ts",
    "validate:academy-registry": "node academy/_data/validate-academy-registry.mjs",
    "bigtime:scrape": "node tools/big-time-pennies/scrape-bigtime-weekly.js --publish-to-site",
    "bigtime:scrape:poll": "node tools/big-time-pennies/run-weekly-scrape-until-new.js",
    "bigtime:local:run": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/big-time-pennies/run-weekly-local.ps1",
    "bigtime:local:install-task": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/big-time-pennies/install-local-weekly-task.ps1",
    "bigtime:local:status": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/big-time-pennies/show-local-weekly-status.ps1",
    "verify:levels-system": "vitest run src/lib/support-resistance/__tests__/levels-system-adapter.test.ts src/lib/support-resistance/__tests__/levels-system-comparison.test.ts src/lib/support-resistance/market-structure-audit/__tests__/build-experimental-market-structure-audit.test.ts src/lib/support-resistance/market-structure-audit/__tests__/evaluate-market-structure-calibration.test.ts src/lib/support-resistance/market-structure-audit/__tests__/evaluate-market-structure-promotion-readiness.test.ts src/lib/support-resistance/market-structure-audit/__tests__/format-market-structure-calibration-report.test.ts src/lib/support-resistance/market-structure-audit/__tests__/parse-market-structure-audit-trades.test.ts src/lib/support-resistance/market-structure-audit/__tests__/synthetic-market-structure-calibration-scenarios.test.ts src/lib/raw-trade-timeline/__tests__/levels-system-pattern-input.integration.test.ts src/lib/raw-trade-timeline/__tests__/levels-system-trade-candle-context.integration.test.ts src/lib/__tests__/trade-analysis-engine.levels-system.integration.test.ts src/lib/trade-analysis/__tests__/build-trade-analysis-summary.test.ts src/lib/trade-analysis/__tests__/classify-trade-analysis-failure.test.ts src/lib/trade-analysis/__tests__/compare-trade-analysis-debug-dashboards.test.ts src/lib/trade-analysis/__tests__/run-trade-analysis.test.ts src/lib/trade-analysis/__tests__/run-trade-analysis-batch.test.ts src/lib/trade-analysis/__tests__/trade-analysis-api-route.test.ts src/lib/trade-analysis/__tests__/trade-analysis-debug-dashboard.test.ts src/lib/trade-analysis/__tests__/trade-analysis-request-contract.test.ts src/lib/trade-analysis/__tests__/trade-analysis-request-fixtures.test.ts src/lib/trade-analysis/__tests__/trade-analysis-summary.snapshot.test.ts",
    "verify:layer2": "tsx src/scripts/verify-layer2-pattern-detection.ts",
    "verify:layer3": "tsx src/scripts/verify-layer3-pattern-normalization.ts",
    "verify:ti-v3:architecture": "tsx src/scripts/verify-trader-intelligence-v3-architecture.ts",
    "verify:ti-v3:private-data": "tsx src/scripts/verify-trader-intelligence-v3-private-data.ts",
    "verify:ti-v3:private-data:local": "tsx src/scripts/verify-trader-intelligence-v3-private-data.ts --local-only",
    "verify:ti-v3:private-data:history": "tsx src/scripts/verify-trader-intelligence-v3-private-data.ts --history-only",
    "verify:ti-v3:ga0-a1": "npm run verify:ti-v3:architecture && npm run verify:ti-v3:private-data",
    "verify:ti-v3:ga0-a2": "vitest run src/lib/trader-intelligence-v3/__tests__/ga0-a2 src/lib/trader-intelligence-v3/__tests__/architecture-boundary-guard.test.ts --reporter=dot && npm run verify:ti-v3:architecture && npm run verify:ti-v3:private-data",
    "verify:ti-v3:ga0-b": "tsx src/scripts/verify-trader-intelligence-v3-ga0-b.ts",
    "verify:ti-v3:ga1-a": "tsx src/scripts/verify-trader-intelligence-v3-ga1-a.ts",
    "verify:ti-v3:ga1-b": "tsx src/scripts/verify-trader-intelligence-v3-ga1-b.ts",
    "verify:ti-v3:ga1-c": "tsx src/scripts/verify-trader-intelligence-v3-ga1-c.ts",
    "verify:all": "npm test && npm run verify:levels-system && npm run verify:layer2 && npm run verify:layer3",
    "check": "tsc --noEmit && npm run build"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@stoqey/ib": "^1.5.6",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.9.0",
    "decimal.js": "10.6.0",
    "flag-icons": "7.5.0",
    "levels-system-v2": "file:vendor/levels-system-v2",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "overrides": {
    "postcss": "8.5.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "fast-check": "4.9.0",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}
