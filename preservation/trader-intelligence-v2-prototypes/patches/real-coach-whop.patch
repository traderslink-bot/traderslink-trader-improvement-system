+
+function metadataString(
+  metadata: Record<string, unknown> | null,
+  ...keys: string[]
+): string | null {
+  if (!metadata) {
+    return null;
+  }
+
+  for (const key of keys) {
+    const value = metadata[key];
+    if (typeof value === "string" && value.trim()) {
+      return value.trim();
+    }
+  }
+
+  return null;
+}
+
+function stableJson(value: unknown): string {
+  try {
+    return JSON.stringify(value);
+  } catch {
+    return JSON.stringify({ unserializable: true });
+  }
+}
+
+export function runRealCoachMarketplaceMigrations(
+  db: RealCoachMarketplaceDatabase,
+): void {
+  db.exec(`
+    CREATE TABLE IF NOT EXISTS coach_profiles (
+      id TEXT PRIMARY KEY,
+      slug TEXT NOT NULL UNIQUE,
+      display_name TEXT NOT NULL,
+      headline TEXT NOT NULL,
+      bio TEXT NOT NULL,
+      specialties_json TEXT NOT NULL,
+      social_links_json TEXT NOT NULL,
+      whop_url TEXT NOT NULL,
+      app_access_fee_text TEXT NOT NULL,
+      coach_fee_text TEXT NOT NULL,
+      student_cap INTEGER NOT NULL,
+      status TEXT NOT NULL,
+      created_at TEXT NOT NULL,
+      updated_at TEXT NOT NULL
+    );
+
+    CREATE INDEX IF NOT EXISTS coach_profiles_status_idx
+      ON coach_profiles(status);
+
+    CREATE TABLE IF NOT EXISTS coach_access_passes (
+      id TEXT PRIMARY KEY,
+      coach_id TEXT NOT NULL,
+      user_id TEXT NOT NULL,
+      workspace_id TEXT NOT NULL,
+      account_id TEXT NOT NULL,
+      status TEXT NOT NULL,
+      app_fee_text TEXT NOT NULL,
+      paid_at TEXT NOT NULL,
+      expires_at TEXT NOT NULL,
+      payment_reference TEXT NOT NULL,
+      created_at TEXT NOT NULL,
+      updated_at TEXT NOT NULL
+    );
+
+    CREATE INDEX IF NOT EXISTS coach_access_passes_user_coach_idx
+      ON coach_access_passes(user_id, coach_id, expires_at);
+
