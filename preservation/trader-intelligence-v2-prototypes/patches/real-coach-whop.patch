+    const row = this.db
+      .prepare(
+        `SELECT *
+         FROM coach_access_passes
+         WHERE coach_id = ?
+           AND user_id = ?
+           AND status = 'paid'
+           AND expires_at > ?
+         ORDER BY expires_at DESC
