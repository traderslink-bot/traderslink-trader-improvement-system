+        profile.displayName,
+        profile.headline,
+        profile.bio,
+        JSON.stringify(profile.specialties),
+        JSON.stringify(profile.socialLinks),
+        profile.whopUrl,
+        profile.appAccessFeeText,
+        profile.coachFeeText,
+        profile.studentCap,
+        profile.status,
+        profile.createdAt,
+        profile.updatedAt,
+      );
+
+    return profile;
+  }
+
+  updateCoachStatus(input: {
+    coachId: string;
+    status: RealCoachProfileStatus;
+    updatedAt?: string;
+  }): RealCoachProfile | null {
