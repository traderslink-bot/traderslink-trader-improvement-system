+
+  requestCoach(input: {
+    coachId: string;
+    userId?: TraderAnalyticsUserId;
+    workspaceId?: string;
+    accountId?: string;
+    now?: string;
+  }): { relationship: CoachStudentRelationship | null; reason?: string } {
+    const requestedAt = input.now ?? nowIso();
+    const userId = input.userId ?? DEMO_USER_ID;
+    const coach = this.getCoachProfile(input.coachId);
+
+    if (!coach || coach.status !== "approved") {
+      return { relationship: null, reason: "coach_not_approved" };
+    }
+
+    const card = this.buildDirectoryCard(coach, requestedAt);
+    if (card.requestsDisabled) {
+      return { relationship: null, reason: "coach_capacity_full" };
+    }
+
+    const existing = this.getCurrentRelationship({
+      coachId: coach.id,
+      userId,
+      now: requestedAt,
+    });
+    if (existing) {
+      return { relationship: existing };
+    }
+
+    const accessPass = this.getActiveAccessPass({
+      coachId: coach.id,
+      userId,
+      now: requestedAt,
+    });
+    if (!accessPass) {
+      return { relationship: null, reason: "app_access_fee_required" };
+    }
+
+    const relationship: CoachStudentRelationship = {
+      id: compactId("coach_student"),
+      coachId: coach.id,
+      userId,
+      workspaceId: input.workspaceId ?? accessPass.workspaceId,
+      accountId: input.accountId ?? accessPass.accountId,
+      accessPassId: accessPass.id,
+      status: "requested",
+      coachPaymentStatus: "pending",
+      requestedAt,
+      consentedAt: requestedAt,
+      activatedAt: null,
+      expiresAt: accessPass.expiresAt,
+      endedAt: null,
+      createdAt: requestedAt,
+      updatedAt: requestedAt,
+    };
+
+    this.db
+      .prepare(
+        `INSERT INTO coach_student_relationships (
+          id, coach_id, user_id, workspace_id, account_id, access_pass_id,
+          status, coach_payment_status, requested_at, consented_at,
+          activated_at, expires_at, ended_at, created_at, updated_at
+        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
+      )
+      .run(
+        relationship.id,
+        relationship.coachId,
+        relationship.userId,
+        relationship.workspaceId,
+        relationship.accountId,
+        relationship.accessPassId,
+        relationship.status,
+        relationship.coachPaymentStatus,
+        relationship.requestedAt,
+        relationship.consentedAt,
+        relationship.activatedAt,
+        relationship.expiresAt,
+        relationship.endedAt,
+        relationship.createdAt,
+        relationship.updatedAt,
+      );
+
+    return { relationship };
+  }
+
+  confirmCoachPayment(input: {
+    relationshipId: string;
+    confirmedAt?: string;
+  }): CoachStudentRelationship | null {
+    const confirmedAt = input.confirmedAt ?? nowIso();
+    this.db
+      .prepare(
+        `UPDATE coach_student_relationships
+         SET status = 'active',
+             coach_payment_status = 'confirmed',
+             activated_at = COALESCE(activated_at, ?),
+             updated_at = ?
+         WHERE id = ?
+           AND status IN ('requested', 'active')`,
+      )
+      .run(confirmedAt, confirmedAt, input.relationshipId);
+
+    return this.getRelationship(input.relationshipId);
+  }
+
+  listRelationshipsForCoach(input: {
+    coachId: string;
+    includeEnded?: boolean;
+  }): CoachStudentRelationship[] {
+    const rows = input.includeEnded
+      ? this.db
+          .prepare(
+            `SELECT *
+             FROM coach_student_relationships
+             WHERE coach_id = ?
+             ORDER BY requested_at DESC`,
+          )
+          .all(input.coachId)
+      : this.db
+          .prepare(
+            `SELECT *
+             FROM coach_student_relationships
+             WHERE coach_id = ?
+               AND status IN ('requested', 'active')
+             ORDER BY requested_at DESC`,
+          )
+          .all(input.coachId);
+
+    return rows.map((row) => toRelationship(row as CoachRelationshipRow));
+  }
+
+  listStudentCoachViews(input: {
+    userId?: TraderAnalyticsUserId;
+  } = {}): StudentCoachView[] {
+    const userId = input.userId ?? DEMO_USER_ID;
+    return this.db
+      .prepare(
+        `SELECT *
+         FROM coach_student_relationships
+         WHERE user_id = ?
+           AND status IN ('requested', 'active')
+         ORDER BY requested_at DESC`,
+      )
+      .all(userId)
+      .map((row) => toRelationship(row as CoachRelationshipRow))
+      .flatMap((relationship) => {
+        const coach = this.getCoachProfile(relationship.coachId);
+        if (!coach) {
+          return [];
+        }
+
+        return [
+          {
+            relationship,
+            coach,
+            reports: this.listPublishedReports(relationship.id),
+            actionItems: this.listActionItems(relationship.id),
+          },
+        ];
+      });
+  }
+
+  getCoachStudentReadModel(input: {
+    relationshipId: string;
+    coachId: string;
+    trades: SavedExecutionTrade[];
+    reports: SavedTraderAnalyticsReport[];
+    now?: string;
+  }): CoachStudentReadModel | null {
+    const now = input.now ?? nowIso();
+    const relationship = this.getRelationship(input.relationshipId);
+
+    if (
+      !relationship ||
+      relationship.coachId !== input.coachId ||
+      relationship.status !== "active" ||
+      relationship.expiresAt <= now
+    ) {
+      return null;
+    }
+
+    const coach = this.getCoachProfile(relationship.coachId);
+    if (!coach) {
+      return null;
+    }
+
+    return {
+      relationship,
+      coach,
+      trades: input.trades.filter((trade) => trade.userId === relationship.userId),
+      latestReport:
+        input.reports
