+
+  getCoachProfile(coachIdOrSlug: string): RealCoachProfile | null {
+    const row = this.db
+      .prepare(
+        `SELECT *
+         FROM coach_profiles
+         WHERE id = ? OR slug = ?
+         LIMIT 1`,
+      )
+      .get(coachIdOrSlug, coachIdOrSlug) as CoachProfileRow | undefined;
+
+    return row ? toProfile(row) : null;
