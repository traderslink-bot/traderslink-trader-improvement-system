+                  <div>App access: {card.coach.appAccessFeeText}</div>
+                  <div>Coach fee: {card.coach.coachFeeText}</div>
+                  <div>
+                    Students: {card.reservedStudentCount} / {card.coach.studentCap}
+                  </div>
+                </div>
+
+                <Link
+                  className="mt-5 inline-flex border border-sky-800 px-4 py-2 text-sm font-medium text-sky-300 hover:border-sky-400 hover:text-sky-200"
+                  href={`/coaches/${card.coach.slug}`}
+                >
+                  View coach
+                </Link>
+              </article>
+            ))}
+          </section>
+        ) : (
+          <section className="border border-zinc-800 bg-zinc-950 p-5">
+            <h2 className="text-sm font-semibold text-zinc-100">
+              No approved coaches yet
+            </h2>
+            <p className="mt-2 text-sm leading-6 text-zinc-500">
+              Add and approve coaches from the admin coach page before users can
+              request real-person coaching.
+            </p>
+            <Link
+              className="mt-4 inline-flex border border-sky-800 px-4 py-2 text-sm text-sky-300 hover:text-sky-200"
+              href="/admin/coaches"
+            >
+              Open coach admin
+            </Link>
+          </section>
+        )}
+      </div>
+    </main>
+  );
+}
