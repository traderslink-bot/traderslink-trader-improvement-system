+function messageForRequestError(value: string | string[] | undefined): string | null {
+  const raw = Array.isArray(value) ? value[0] : value;
+  switch (raw) {
+    case "coach_capacity_full":
+      return "This coach is at capacity. Requests are disabled until a student slot opens.";
+    case "app_access_fee_required":
+      return "Pay the Trader Intelligence per-coach access fee before requesting this coach.";
+    case "coach_not_approved":
+      return "This coach is not approved for requests.";
+    case "consent_required":
+      return "Confirm coach read-only access consent before requesting this coach.";
+    case "request_failed":
+      return "The coach request could not be created.";
+    default:
+      return null;
+  }
