+      coachFeeText: input.coachFeeText.trim() || "Coach sets fee on Whop",
+      studentCap: Math.max(0, Math.floor(input.studentCap)),
+      status: input.status ?? "draft",
+      createdAt,
+      updatedAt: createdAt,
+    };
+
+    this.db
+      .prepare(
+        `INSERT INTO coach_profiles (
+          id, slug, display_name, headline, bio, specialties_json,
+          social_links_json, whop_url, app_access_fee_text, coach_fee_text,
+          student_cap, status, created_at, updated_at
+        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
+      )
+      .run(
+        profile.id,
