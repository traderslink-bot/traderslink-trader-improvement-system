+    events,
+    records: state,
+    listPeriodReflections(args) {
+      return state.filter(
+        (record) =>
+          record.userId === args.userId &&
+          (!args.accountId || record.accountId === args.accountId) &&
+          (!args.kind || record.kind === args.kind),
+      );
+    },
+    savePeriodReflection(record) {
+      const index = state.findIndex((candidate) => candidate.id === record.id);
