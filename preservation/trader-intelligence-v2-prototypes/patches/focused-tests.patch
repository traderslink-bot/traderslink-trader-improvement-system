+
+    expect(relationship).not.toBeNull();
+
+    const trades = [
+      {
+        id: "trade-one",
+        userId: DEMO_USER_ID,
+        symbol: "AAPL",
+        sessionDate: "2026-06-02",
+        reviewStatus: "new",
