+import Image from "next/image";
+import Link from "next/link";
+import type { Metadata } from "next";
+
+import { ManualEntryClient } from "./manual-entry-client";
+
+export const metadata: Metadata = {
+  title: "Manual Trade Entry | Trader Intelligence",
+};
+
+export default function ManualEntryPage() {
+  return (
+    <main className="ti-dashboard-bg min-h-screen px-5 py-6 text-zinc-100 sm:px-8">
+      <div className="mx-auto flex w-full max-w-6xl flex-col gap-6">
+        <header className="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
+          <Link
+            aria-label="Back to workspace"
+            className="inline-flex w-fit items-center rounded-md border border-sky-900/80 bg-sky-950/25 px-3 py-2 text-sm font-medium text-sky-200 transition hover:border-sky-500 hover:text-sky-100"
+            href="/workspace"
+          >
+            Back to workspace
+          </Link>
+          <Image
+            alt="TradersLink"
+            className="h-auto w-52 object-contain sm:w-64"
+            height={72}
+            priority
+            src="/logo-horizontal-main.png"
+            width={420}
+          />
+        </header>
+
+        <section className="ti-panel p-5 sm:p-6">
+          <p className="text-xs font-semibold uppercase tracking-wide text-emerald-300">
+            Manual entry
+          </p>
+          <h1 className="mt-3 text-3xl font-semibold text-zinc-50 sm:text-4xl">
+            Enter manual executions.
+          </h1>
+          <p className="mt-3 max-w-3xl text-sm leading-6 text-zinc-400">
+            Add exact NYSE or Nasdaq stock fills when you do not have a broker
+            CSV.
+          </p>
+        </section>
+
+        <ManualEntryClient />
+      </div>
+    </main>
+  );
+}
