diff --git a/app/manual-entry/manual-entry-client.tsx b/app/manual-entry/manual-entry-client.tsx
new file mode 100644
index 00000000..36a0c7a0
--- /dev/null
+++ b/app/manual-entry/manual-entry-client.tsx
@@ -0,0 +1,578 @@
+"use client";
+
+import { useMemo, useState, type FormEvent } from "react";
+
+import {
+  buildManualExecutionEntryCsv,
+  MANUAL_EXECUTION_TIMEZONE,
+  type ManualExecutionEntryIssue,
+  type ManualExecutionEntryRow,
+} from "../../src/lib/trader-analytics/product/manual-execution-entry";
+
+type ManualEntryStatus = "idle" | "previewing" | "saving" | "saved" | "error";
+
+interface ImportPreviewPlanResponse {
+  plan?: {
+    canCommitNow: boolean;
+    batch: {
+      id: string;
+    };
+    readModel?: {
+      nextAction?: string;
+    };
+    requiredDecisions?: Array<{
+      message: string;
+    }>;
+  };
+  error?: {
+    message?: string;
+  };
+}
+
+interface ImportCommitResponse {
+  result?: {
+    message?: string;
+  };
+  error?: {
+    message?: string;
+  };
+}
+
+interface ManualEntryResult {
+  title: string;
+  message: string;
+  href: string;
+  actionLabel: string;
+  tone: "success" | "attention";
+}
+
+function newRow(index: number): ManualExecutionEntryRow {
+  return {
+    id: `manual-row-${Date.now()}-${index}`,
+    date: "",
+    time: "",
+    symbol: "",
+    side: "",
+    quantity: "",
+    price: "",
+  };
+}
+
+const INITIAL_ROWS: ManualExecutionEntryRow[] = [
+  {
+    ...newRow(1),
+    side: "BUY",
+  },
+  {
+    ...newRow(2),
+    side: "SELL",
+  },
+];
+
+const MANUAL_ENTRY_TEXT_FIELDS = [
+  ["date", "Date", "2026-06-12"],
+  ["time", "Time", "10:30:15"],
+  ["symbol", "Symbol", "AAPL"],
+  ["quantity", "Quantity", "50"],
+  ["price", "Price", "180.50"],
+] as const satisfies ReadonlyArray<
+  readonly [keyof ManualExecutionEntryRow, string, string]
+>;
+
+function issueFor(
+  issues: ManualExecutionEntryIssue[],
+  rowId: string,
+  field: keyof ManualExecutionEntryRow,
+): string | null {
+  return issues.find((issue) => issue.rowId === rowId && issue.field === field)
+    ?.message ?? null;
+}
+
+async function readApiJson<T>(response: Response, fallbackMessage: string): Promise<T> {
+  const contentType = response.headers.get("content-type") ?? "";
+  const text = await response.text();
+
+  if (!contentType.toLowerCase().includes("application/json")) {
+    throw new Error(fallbackMessage);
+  }
+
+  try {
+    return JSON.parse(text) as T;
+  } catch {
+    throw new Error(fallbackMessage);
+  }
+}
+
+function friendlyError(error: unknown): string {
+  return error instanceof Error && error.message.trim() !== ""
+    ? error.message
+    : "Manual executions could not be saved.";
+}
+
+export function ManualEntryClient() {
+  const [rows, setRows] = useState<ManualExecutionEntryRow[]>(INITIAL_ROWS);
+  const [status, setStatus] = useState<ManualEntryStatus>("idle");
+  const [message, setMessage] = useState<string | null>(null);
+  const [result, setResult] = useState<ManualEntryResult | null>(null);
+  const csvResult = useMemo(() => buildManualExecutionEntryCsv(rows), [rows]);
+  const [showCsv, setShowCsv] = useState(false);
+
+  function updateRow(
+    rowId: string,
+    field: keyof ManualExecutionEntryRow,
+    value: string,
+  ) {
+    setRows((current) =>
+      current.map((row) =>
+        row.id === rowId
+          ? {
+              ...row,
+              [field]:
+                field === "side"
+                  ? value === "BUY" || value === "SELL"
+                    ? value
+                    : ""
+                  : value,
+            }
+          : row,
+      ),
+    );
+    setStatus("idle");
+    setMessage(null);
+    setResult(null);
+  }
+
+  function addRow() {
+    setRows((current) => [...current, newRow(current.length + 1)]);
+  }
+
+  function removeRow(rowId: string) {
+    setRows((current) =>
+      current.length > 1 ? current.filter((row) => row.id !== rowId) : current,
+    );
+  }
+
+  async function submitManualEntry(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    setMessage(null);
+    setResult(null);
+
+    if (csvResult.issues.length > 0) {
+      setStatus("error");
+      setMessage(csvResult.issues[0]?.message ?? "Fix the highlighted rows.");
+      return;
+    }
+
+    const payload = {
+      acknowledgements: {
+        groupingReview: true,
+        mappingReview: true,
+        openPositions: true,
+        pnlReview: true,
+      },
+      accountTimezone: MANUAL_EXECUTION_TIMEZONE,
+      broker: "generic_execution_csv",
+      csvText: csvResult.csvText,
+      repairSource: "original_csv",
+    };
+
+    try {
+      setStatus("previewing");
+      const previewResponse = await fetch("/api/import-batches/preview", {
+        method: "POST",
+        headers: { "content-type": "application/json" },
+        body: JSON.stringify(payload),
+      });
+      const previewBody = await readApiJson<ImportPreviewPlanResponse>(
+        previewResponse,
+        "Manual executions could not be checked.",
+      );
+
+      if (!previewResponse.ok || !previewBody.plan) {
+        throw new Error(
+          previewBody.error?.message ?? "Manual executions could not be checked.",
+        );
+      }
+
+      const batchId = previewBody.plan.batch.id;
+
+      if (!previewBody.plan.canCommitNow) {
+        setStatus("idle");
+        setResult({
+          tone: "attention",
+          title: "Manual executions need review",
+          message:
+            previewBody.plan.requiredDecisions?.[0]?.message ??
+            previewBody.plan.readModel?.nextAction ??
+            "Open the import details to review the execution grouping before saving.",
+          href: `/imports/${encodeURIComponent(batchId)}`,
+          actionLabel: "Review import",
+        });
+        return;
+      }
+
+      setStatus("saving");
+      const commitResponse = await fetch(
+        `/api/import-batches/${encodeURIComponent(batchId)}/commit`,
+        {
+          method: "POST",
+          headers: { "content-type": "application/json" },
+          body: JSON.stringify(payload),
+        },
+      );
+      const commitBody = await readApiJson<ImportCommitResponse>(
+        commitResponse,
+        "Manual executions could not be saved.",
+      );
+
+      if (!commitResponse.ok || !commitBody.result) {
+        throw new Error(
+          commitBody.error?.message ?? "Manual executions could not be saved.",
+        );
+      }
+
+      setStatus("saved");
+      setResult({
+        tone: "success",
+        title: "Manual executions saved",
+        message:
+          commitBody.result.message ??
+          "The executions are saved and ready for review.",
+        href: `/imports/${encodeURIComponent(batchId)}`,
+        actionLabel: "Open saved import",
+      });
+    } catch (error) {
+      setStatus("error");
+      setMessage(friendlyError(error));
+    }
+  }
+
+  const busy = status === "previewing" || status === "saving";
+
+  return (
+    <section
+      className="ti-panel min-w-0 p-4 shadow-2xl shadow-black/20 sm:p-5"
+      data-testid="manual-entry-client"
+    >
+      <form
+        className="grid min-w-0 gap-5"
+        onSubmit={(event) => void submitManualEntry(event)}
+      >
+        <div className="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
+          <div className="text-sm leading-6 text-zinc-400">
+            For each execution, enter whether it was a buy or sell and the share
+            size bought or sold. Times are saved in Eastern Time.
+          </div>
+          <button
+            className="w-fit rounded-md border border-sky-800 bg-sky-950/35 px-4 py-2 text-sm font-semibold text-sky-100 transition hover:border-sky-400"
+            data-testid="manual-entry-add-row"
+            type="button"
+            onClick={addRow}
+          >
+            Add execution
+          </button>
+        </div>
+
+        <div className="grid min-w-0 gap-2">
+          <div className="grid gap-4 md:hidden">
+            {rows.map((row, index) => (
+              <div
+                className="grid gap-3 rounded-md border border-zinc-800 bg-zinc-950/35 p-3"
+                key={row.id}
+              >
+                <div className="flex items-center justify-between gap-3">
+                  <div className="text-xs font-semibold uppercase tracking-wide text-zinc-500">
+                    Execution {index + 1}
+                  </div>
+                  <button
+                    className="rounded-md border border-zinc-800 px-3 py-2 text-xs font-semibold text-zinc-300 transition hover:border-rose-500 hover:text-rose-200 disabled:opacity-40"
+                    data-testid={`manual-entry-mobile-remove-${index}`}
+                    disabled={rows.length <= 1}
+                    type="button"
+                    onClick={() => removeRow(row.id)}
+                  >
+                    Remove
+                  </button>
+                </div>
+
+                <div className="grid gap-3">
+                  {MANUAL_ENTRY_TEXT_FIELDS.map(([field, label, placeholder]) => {
+                    const issue = issueFor(csvResult.issues, row.id, field);
+
+                    return (
+                      <label
+                        className="grid gap-1 text-sm font-medium text-zinc-300"
+                        key={field}
+                      >
+                        <span>{label}</span>
+                        <input
+                          aria-label={`${field} row ${index + 1}`}
+                          className={`w-full rounded-md border bg-zinc-950 px-3 py-2 text-sm text-zinc-100 outline-none focus:border-sky-500 ${
+                            issue ? "border-rose-700" : "border-zinc-800"
+                          }`}
+                          data-testid={`manual-entry-mobile-${field}-${index}`}
+                          placeholder={placeholder}
+                          value={String(row[field] ?? "")}
+                          onChange={(event) =>
+                            updateRow(row.id, field, event.target.value)
+                          }
+                        />
+                        {issue ? (
+                          <span className="text-xs text-rose-300">{issue}</span>
+                        ) : null}
+                      </label>
+                    );
+                  })}
+
+                  <label className="grid gap-1 text-sm font-medium text-zinc-300">
+                    <span>Side</span>
+                    <select
+                      aria-label={`side row ${index + 1}`}
+                      className={`w-full rounded-md border bg-zinc-950 px-3 py-2 text-sm text-zinc-100 outline-none focus:border-sky-500 ${
+                        issueFor(csvResult.issues, row.id, "side")
+                          ? "border-rose-700"
+                          : "border-zinc-800"
+                      }`}
+                      data-testid={`manual-entry-mobile-side-${index}`}
+                      value={row.side}
+                      onChange={(event) =>
+                        updateRow(row.id, "side", event.target.value)
+                      }
+                    >
+                      <option value="">Choose</option>
+                      <option value="BUY">Buy</option>
+                      <option value="SELL">Sell</option>
+                    </select>
+                    {issueFor(csvResult.issues, row.id, "side") ? (
+                      <span className="text-xs text-rose-300">
+                        {issueFor(csvResult.issues, row.id, "side")}
+                      </span>
+                    ) : null}
+                  </label>
+                </div>
+              </div>
+            ))}
+          </div>
+
+          <div className="relative hidden min-w-0 md:block">
+            <div className="overflow-x-auto" data-testid="manual-entry-table-scroll">
+              <table className="min-w-[720px] w-full border-separate border-spacing-0 text-left text-sm">
+                <thead>
+                  <tr className="text-xs uppercase tracking-wide text-zinc-500">
+                    <th className="border-b border-zinc-800 p-2">Date</th>
+                    <th className="border-b border-zinc-800 p-2">Time</th>
+                    <th className="border-b border-zinc-800 p-2">Symbol</th>
+                    <th className="border-b border-zinc-800 p-2">Side</th>
+                    <th className="border-b border-zinc-800 p-2">Quantity</th>
+                    <th className="border-b border-zinc-800 p-2">Price</th>
+                    <th className="border-b border-zinc-800 p-2"> </th>
+                  </tr>
+                </thead>
+                <tbody>
+                  {rows.map((row, index) => (
+                    <tr key={row.id} className="align-top">
+                      {([
+                        ["date", "2026-06-12"],
+                        ["time", "10:30:15"],
+                        ["symbol", "AAPL"],
+                      ] as Array<[keyof ManualExecutionEntryRow, string]>).map(
+                        ([field, placeholder]) => {
+                          const issue = issueFor(csvResult.issues, row.id, field);
+
+                          return (
+                            <td className="p-2" key={field}>
+                              <input
+                                aria-label={`${field} row ${index + 1}`}
+                                className={`w-full border bg-zinc-950 px-2 py-2 text-sm text-zinc-100 outline-none focus:border-sky-500 ${
+                                  issue ? "border-rose-700" : "border-zinc-800"
+                                }`}
+                                data-testid={`manual-entry-${field}-${index}`}
+                                placeholder={placeholder}
+                                value={String(row[field] ?? "")}
+                                onChange={(event) =>
+                                  updateRow(row.id, field, event.target.value)
+                                }
+                              />
+                              {issue ? (
+                                <div className="mt-1 text-xs text-rose-300">
+                                  {issue}
+                                </div>
+                              ) : null}
+                            </td>
+                          );
+                        },
+                      )}
+                      <td className="p-2">
+                        <select
+                          aria-label={`side row ${index + 1}`}
+                          className={`w-full border bg-zinc-950 px-2 py-2 text-sm text-zinc-100 outline-none focus:border-sky-500 ${
+                            issueFor(csvResult.issues, row.id, "side")
+                              ? "border-rose-700"
+                              : "border-zinc-800"
+                          }`}
+                          data-testid={`manual-entry-side-${index}`}
+                          value={row.side}
+                          onChange={(event) =>
+                            updateRow(row.id, "side", event.target.value)
+                          }
+                        >
+                          <option value="">Choose</option>
+                          <option value="BUY">Buy</option>
+                          <option value="SELL">Sell</option>
+                        </select>
+                        {issueFor(csvResult.issues, row.id, "side") ? (
+                          <div className="mt-1 text-xs text-rose-300">
+                            {issueFor(csvResult.issues, row.id, "side")}
+                          </div>
+                        ) : null}
+                      </td>
+                      {([
+                        ["quantity", "50"],
+                        ["price", "180.50"],
+                      ] as Array<[keyof ManualExecutionEntryRow, string]>).map(
+                        ([field, placeholder]) => {
+                          const issue = issueFor(csvResult.issues, row.id, field);
+
+                          return (
+                            <td className="p-2" key={field}>
+                              <input
+                                aria-label={`${field} row ${index + 1}`}
+                                className={`w-full border bg-zinc-950 px-2 py-2 text-sm text-zinc-100 outline-none focus:border-sky-500 ${
+                                  issue ? "border-rose-700" : "border-zinc-800"
+                                }`}
+                                data-testid={`manual-entry-${field}-${index}`}
+                                placeholder={placeholder}
+                                value={String(row[field] ?? "")}
+                                onChange={(event) =>
+                                  updateRow(row.id, field, event.target.value)
+                                }
+                              />
+                              {issue ? (
+                                <div className="mt-1 text-xs text-rose-300">
+                                  {issue}
+                                </div>
+                              ) : null}
+                            </td>
+                          );
+                        },
+                      )}
+                      <td className="p-2">
+                        <button
+                          className="rounded-md border border-zinc-800 px-3 py-2 text-xs font-semibold text-zinc-300 transition hover:border-rose-500 hover:text-rose-200 disabled:opacity-40"
+                          data-testid={`manual-entry-remove-${index}`}
+                          disabled={rows.length <= 1}
+                          type="button"
+                          onClick={() => removeRow(row.id)}
+                        >
+                          Remove
+                        </button>
+                      </td>
+                    </tr>
+                  ))}
+                </tbody>
+              </table>
+            </div>
+            <div
+              aria-hidden="true"
+              className="pointer-events-none absolute inset-y-0 right-0 w-12 bg-gradient-to-l from-zinc-950 to-transparent sm:hidden"
+            />
+          </div>
+        </div>
+
+        <div className="grid gap-3 rounded-md border border-zinc-800 bg-zinc-950/45 p-4 md:grid-cols-3">
+          <div>
+            <div className="text-xs uppercase tracking-wide text-zinc-500">
+              Rows
+            </div>
+            <div className="mt-1 font-mono text-lg text-zinc-100">
+              {csvResult.includedRowCount}
+            </div>
+          </div>
+          <div>
+            <div className="text-xs uppercase tracking-wide text-zinc-500">
+              Local checks
+            </div>
+            <div
+              className={`mt-1 font-mono text-lg ${
+                csvResult.issues.length > 0 ? "text-amber-300" : "text-emerald-300"
+              }`}
+              data-testid="manual-entry-local-checks"
+            >
+              {csvResult.issues.length}
+            </div>
+          </div>
+          <div>
+            <div className="text-xs uppercase tracking-wide text-zinc-500">
+              Save path
+            </div>
+            <div className="mt-1 text-sm text-sky-200">
+              Generic execution import
+            </div>
+          </div>
+        </div>
+
+        <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
+          <button
+            className="rounded-md border border-emerald-700 bg-emerald-950/40 px-4 py-3 text-sm font-semibold text-emerald-100 transition hover:border-emerald-300 disabled:cursor-not-allowed disabled:border-zinc-800 disabled:text-zinc-500"
+            data-testid="manual-entry-save"
+            disabled={busy}
+            type="submit"
+          >
+            {status === "previewing"
+              ? "Checking..."
+              : status === "saving"
+                ? "Saving..."
+                : "Check and save executions"}
+          </button>
+          <button
+            className="w-fit text-sm text-sky-300 transition hover:text-sky-200"
+            type="button"
+            onClick={() => setShowCsv((current) => !current)}
+          >
+            {showCsv ? "Hide generated CSV" : "Show generated CSV"}
+          </button>
+        </div>
+
+        {message ? (
+          <p className="text-sm text-rose-300" data-testid="manual-entry-message">
+            {message}
+          </p>
+        ) : null}
+
+        {result ? (
+          <div
+            className={`rounded-md border p-4 ${
+              result.tone === "success"
+                ? "border-emerald-800 bg-emerald-950/30"
+                : "border-amber-800 bg-amber-950/30"
+            }`}
+            data-testid="manual-entry-result"
+            role="status"
+          >
+            <h2 className="text-sm font-semibold text-zinc-50">{result.title}</h2>
+            <p className="mt-2 text-sm leading-6 text-zinc-300">
+              {result.message}
+            </p>
+            <a
+              className="mt-4 inline-flex rounded-md border border-sky-800 bg-sky-950/40 px-4 py-2 text-sm font-semibold text-sky-100 transition hover:border-sky-400"
+              data-testid="manual-entry-result-link"
+              href={result.href}
+            >
+              {result.actionLabel}
+            </a>
+          </div>
+        ) : null}
+
+        {showCsv ? (
+          <textarea
+            aria-label="Generated CSV"
+            className="min-h-40 w-full resize-y border border-zinc-800 bg-zinc-950 px-3 py-3 font-mono text-xs leading-5 text-zinc-200 outline-none"
+            data-testid="manual-entry-generated-csv"
+            readOnly
+            value={csvResult.csvText}
+          />
+        ) : null}
+      </form>
+    </section>
+  );
+}
