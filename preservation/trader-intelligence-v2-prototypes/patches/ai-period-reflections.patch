+import {
+  buildPersistedTraderPeriodReflection,
+  PERIOD_REFLECTION_NARRATIVE_CONTRACT,
+} from "../product/period-reflections";
+import type {
+  PersistedTraderPeriodReflectionGenerationEvent,
+  PersistedTraderPeriodReflection,
+  TraderAnalyticsAccountId,
+  TraderAnalyticsUserId,
+  TraderPeriodReflection,
+  TraderPeriodReflectionKind,
+  TraderPeriodReflectionTokenUsage,
+  TraderPeriodReflectionUsage,
+} from "../product/types";
+
+export const DEFAULT_OPENAI_REFLECTION_MODEL = "gpt-5.4-mini";
+export const OPENAI_RESPONSES_ENDPOINT = "https://api.openai.com/v1/responses";
+export const OPENAI_REFLECTION_PRICING_SOURCE =
+  "openai_api_pricing_2026_06_13";
+
+type FetchLike = typeof fetch;
+
+interface OpenAIReflectionModelPricing {
+  inputUsdPerMillion: number;
+  cachedInputUsdPerMillion: number;
+  outputUsdPerMillion: number;
+}
+
+const knownOpenAIReflectionModelPricing: Record<
+  string,
+  OpenAIReflectionModelPricing
+> = {
+  "gpt-5.5": {
+    inputUsdPerMillion: 5,
+    cachedInputUsdPerMillion: 0.5,
+    outputUsdPerMillion: 30,
+  },
+  "gpt-5.4": {
+    inputUsdPerMillion: 2.5,
+    cachedInputUsdPerMillion: 0.25,
+    outputUsdPerMillion: 15,
+  },
+  "gpt-5.4-mini": {
