+export interface GenerateTraderPeriodReflectionArgs {
+  accountId: TraderAnalyticsAccountId;
+  generatedAt?: string;
+  openai?: OpenAIReflectionWriterConfig;
+  reflection: TraderPeriodReflection;
+  repository: TraderPeriodReflectionRepository;
