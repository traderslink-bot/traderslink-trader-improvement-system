+
+export interface TraderPeriodReflectionRepository {
+  listPeriodReflections(args: {
+    accountId?: string;
+    kind?: TraderPeriodReflectionKind;
+    userId: TraderAnalyticsUserId;
+  }): PersistedTraderPeriodReflection[];
