@@ -0,0 +1,105 @@
+import {
+  parseTraderPeriodReflectionGenerationRequest,
+  runTraderPeriodReflectionGeneration,
+  TraderPeriodReflectionGenerationUnavailableError,
+} from "../../../../src/lib/trader-analytics/server/period-reflection-service";
+import {
+  canUseAiPeriodReflections,
+  readTraderIntelligenceTierFromEnv,
+} from "../../../../src/lib/trader-analytics/product/tier-config";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+type ReflectionGenerationErrorCode =
+  | "invalid_json"
+  | "invalid_request"
+  | "no_saved_report"
+  | "tier_required"
+  | "period_not_ready"
+  | "generation_failed";
+
+function errorResponse(
+  status: number,
+  code: ReflectionGenerationErrorCode,
+  message: string,
+): Response {
+  return Response.json(
+    {
+      contractVersion: "trader_period_reflection_generation_error_v1",
+      error: { code, message },
+    },
+    { status },
+  );
+}
+
+async function readOptionalJson(request: Request): Promise<unknown> {
+  const text = await request.text();
+
+  if (!text.trim()) {
+    return {};
+  }
+
+  try {
+    return JSON.parse(text);
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+    throw new Error(`Invalid JSON: ${message}`);
+  }
+}
+
+export async function POST(request: Request): Promise<Response> {
+  let input;
+
+  try {
+    input = parseTraderPeriodReflectionGenerationRequest(
+      await readOptionalJson(request),
+    );
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+
+    return errorResponse(
+      400,
+      message.startsWith("Invalid JSON") ? "invalid_json" : "invalid_request",
+      message,
+    );
+  }
+
+  const activeTier = readTraderIntelligenceTierFromEnv();
+
+  if (!canUseAiPeriodReflections(activeTier)) {
+    return errorResponse(
+      403,
+      "tier_required",
+      "AI trading reviews are available on the chart-context paid tier.",
+    );
+  }
+
+  try {
+    const result = await runTraderPeriodReflectionGeneration(input);
+
+    return Response.json(result);
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+
+    if (message.includes("No saved analytics report")) {
+      return errorResponse(409, "no_saved_report", message);
+    }
+
+    if (error instanceof TraderPeriodReflectionGenerationUnavailableError) {
+      return Response.json(
+        {
+          contractVersion: "trader_period_reflection_generation_error_v1",
+          error: {
+            code: "period_not_ready",
+            message,
+            unavailable: error.unavailable,
+          },
+        },
+        { status: 409 },
+      );
+    }
+
+    return errorResponse(500, "generation_failed", message);
+  }
+}
