import Link from "next/link";
import type { Metadata } from "next";
import {
  adminGrantPrototypeAppAccessAction,
  confirmCoachPaymentAction,
  createCoachProfileAction,
  seedPrototypeCoachAction,
  updateCoachCapacityAction,
  updateCoachStatusAction,
} from "../../real-coach-actions";
import { getRealCoachActor } from "../../real-coach-auth";
import { createRealCoachMarketplaceRepository } from "../../../src/lib/trader-analytics/product/real-coach-marketplace";

export const metadata: Metadata = {
  title: "Coach Admin | Trader Intelligence",
};

export const dynamic = "force-dynamic";

export default async function CoachAdminPage() {
  const actor = await getRealCoachActor();

  if (actor?.role !== "admin") {
    return (
      <main className="min-h-screen bg-zinc-950 px-5 py-8 text-zinc-100 sm:px-8">
        <div className="mx-auto flex w-full max-w-4xl flex-col gap-6">
          <Link className="text-sm text-sky-300 hover:text-sky-200" href="/admin">
            Back to admin
          </Link>
          <section className="border border-amber-900/70 bg-amber-950/10 p-5">
            <h1 className="text-2xl font-semibold text-zinc-50">
              Admin view required
            </h1>
            <p className="mt-2 text-sm leading-6 text-zinc-400">
              Coach marketplace administration now requires an explicit admin
              view. Choose the admin view before creating coaches or changing
              payment/access state.
            </p>
            <Link
              className="mt-4 inline-flex border border-amber-800 px-4 py-2 text-sm text-amber-300 hover:border-amber-400"
              href="/real-coach-session?required=admin&next=/admin/coaches"
            >
              Choose admin view
            </Link>
          </section>
        </div>
      </main>
    );
  }

  const repository = createRealCoachMarketplaceRepository();
  const coaches = repository.listCoachProfiles();
  const paymentEvents = repository.listPaymentEvents(12);

  return (
    <main className="min-h-screen bg-zinc-950 px-5 py-8 text-zinc-100 sm:px-8">
      <div className="mx-auto flex w-full max-w-7xl flex-col gap-8">
        <header className="border-b border-zinc-800 pb-6">
          <Link className="text-sm text-sky-300 hover:text-sky-200" href="/admin">
            Back to admin
          </Link>
          <p className="mt-4 text-xs font-semibold uppercase tracking-wide text-amber-300">
            Coach Admin
          </p>
          <h1 className="mt-2 text-3xl font-semibold text-zinc-50">
            Real Coach Marketplace Admin
          </h1>
          <p className="mt-2 max-w-3xl text-sm leading-6 text-zinc-500">
            Manually approve coaches, set capacity, and activate student access
            after coach-owned Whop payment is confirmed outside the app.
          </p>
        </header>

        <section className="border border-emerald-900/70 bg-emerald-950/10 p-4">
          <div className="flex flex-col justify-between gap-4 md:flex-row md:items-center">
            <div>
              <h2 className="text-sm font-semibold text-emerald-200">
                Local Demo Coach
              </h2>
              <p className="mt-2 max-w-3xl text-sm leading-6 text-zinc-400">
                Add one approved demo coach so the directory, app-access fee,
                request, activation, feedback, and action-item flow can be
                tested without manually filling the profile form.
              </p>
            </div>
            <form action={seedPrototypeCoachAction}>
              <button
                className="border border-emerald-700 px-4 py-2 text-sm font-medium text-emerald-200 hover:border-emerald-400"
                type="submit"
              >
                Seed demo coach
              </button>
            </form>
          </div>
        </section>

        <section className="grid gap-6 xl:grid-cols-[420px_minmax(0,1fr)]">
          <form
            action={createCoachProfileAction}
            className="border border-zinc-800 bg-zinc-950 p-5"
          >
            <h2 className="text-sm font-semibold text-zinc-100">
              Add Coach Profile
            </h2>
            <div className="mt-4 grid gap-3">
              <input
                className="border border-zinc-800 bg-zinc-950 px-3 py-2 text-sm text-zinc-100"
                name="displayName"
                placeholder="Coach display name"
                required
              />
              <input
                className="border border-zinc-800 bg-zinc-950 px-3 py-2 text-sm text-zinc-100"
                name="headline"
                placeholder="Short headline"
              />
              <textarea
                className="min-h-28 border border-zinc-800 bg-zinc-950 px-3 py-2 text-sm text-zinc-100"
                name="bio"
                placeholder="Coach bio"
              />
              <textarea
                className="min-h-20 border border-zinc-800 bg-zinc-950 px-3 py-2 text-sm text-zinc-100"
                name="specialtiesText"
                placeholder="Specialties, comma or line separated"
              />
              <textarea
                className="min-h-20 border border-zinc-800 bg-zinc-950 px-3 py-2 text-sm text-zinc-100"
                name="socialLinksText"
                placeholder="Social links, one per line: YouTube | https://..."
              />
              <input
                className="border border-zinc-800 bg-zinc-950 px-3 py-2 text-sm text-zinc-100"
                name="whopUrl"
                placeholder="Coach Whop URL"
              />
              <input
                className="border border-zinc-800 bg-zinc-950 px-3 py-2 text-sm text-zinc-100"
                name="appAccessFeeText"
                placeholder="Trader Intelligence app access fee"
              />
              <input
                className="border border-zinc-800 bg-zinc-950 px-3 py-2 text-sm text-zinc-100"
                name="coachFeeText"
                placeholder="Coach Whop fee text"
              />
              <input
                className="border border-zinc-800 bg-zinc-950 px-3 py-2 text-sm text-zinc-100"
                min="0"
                name="studentCap"
                placeholder="Student cap"
                type="number"
              />
              <label className="flex items-center gap-2 text-sm text-zinc-400">
                <input name="status" type="checkbox" value="approved" />
                Approve immediately
              </label>
              <button
                className="border border-sky-800 px-4 py-2 text-sm text-sky-300 hover:border-sky-400"
                type="submit"
              >
                Create coach
              </button>
            </div>
          </form>

          <section className="grid gap-4">
            {coaches.length > 0 ? (
              coaches.map((coach) => {
                const card = repository.buildDirectoryCard(coach);
                const relationships = repository.listRelationshipsForCoach({
                  coachId: coach.id,
                });

                return (
                  <article
                    className="border border-zinc-800 bg-zinc-950 p-5"
                    key={coach.id}
                  >
                    <div className="flex flex-col justify-between gap-4 border-b border-zinc-900 pb-4 lg:flex-row">
                      <div>
                        <p className="text-xs uppercase tracking-wide text-zinc-500">
                          {coach.status} / {card.reservedStudentCount} reserved
                        </p>
                        <h2 className="mt-1 text-lg font-semibold text-zinc-50">
                          {coach.displayName}
                        </h2>
                        <p className="mt-1 text-sm text-zinc-500">
                          {coach.headline}
                        </p>
                      </div>
                      <div className="flex flex-wrap gap-2">
                        {(["approved", "draft", "hidden"] as const).map((status) => (
                          <form action={updateCoachStatusAction} key={status}>
                            <input name="coachId" type="hidden" value={coach.id} />
                            <input name="status" type="hidden" value={status} />
                            <button
                              className={`border px-3 py-2 text-xs uppercase tracking-wide ${
                                coach.status === status
                                  ? "border-emerald-800 text-emerald-300"
                                  : "border-zinc-800 text-zinc-500 hover:text-zinc-300"
                              }`}
                              type="submit"
                            >
                              {status}
                            </button>
                          </form>
                        ))}
                      </div>
                    </div>

                    <div className="mt-4 grid gap-4 lg:grid-cols-3">
                      <form
                        action={updateCoachCapacityAction}
                        className="border border-zinc-900 p-4"
                      >
                        <input name="coachId" type="hidden" value={coach.id} />
                        <label className="text-xs uppercase tracking-wide text-zinc-500">
                          Student cap
                        </label>
                        <div className="mt-2 flex gap-2">
                          <input
                            className="min-w-0 flex-1 border border-zinc-800 bg-zinc-950 px-3 py-2 text-sm text-zinc-100"
                            defaultValue={coach.studentCap}
                            min="0"
                            name="studentCap"
                            type="number"
                          />
                          <button
                            className="border border-zinc-700 px-3 py-2 text-sm text-zinc-200"
                            type="submit"
                          >
                            Save
                          </button>
                        </div>
                      </form>

                      <div className="border border-zinc-900 p-4 text-sm text-zinc-400">
                        <p className="text-xs uppercase tracking-wide text-zinc-500">
                          Payments
                        </p>
                        <p className="mt-2">App fee: {coach.appAccessFeeText}</p>
                        <p className="mt-1">Coach fee: {coach.coachFeeText}</p>
                        <form
                          action={adminGrantPrototypeAppAccessAction}
                          className="mt-3"
                        >
                          <input name="coachId" type="hidden" value={coach.id} />
                          <input
                            name="paymentReference"
                            type="hidden"
                            value={`prototype-admin:${coach.slug}`}
                          />
                          <button
                            className="border border-amber-800 px-3 py-2 text-xs font-medium uppercase tracking-wide text-amber-300 hover:border-amber-400"
                            type="submit"
                          >
                            Grant demo app access
                          </button>
                        </form>
                      </div>

                      <div className="border border-zinc-900 p-4 text-sm text-zinc-400">
                        <p className="text-xs uppercase tracking-wide text-zinc-500">
                          Directory
                        </p>
                        <p className="mt-2">
                          {card.requestsDisabled
                            ? "Requests disabled"
                            : `${card.availableSeatCount} request slot available`}
                        </p>
                        <Link
                          className="mt-2 inline-flex text-sky-300 hover:text-sky-200"
                          href={`/coaches/${coach.slug}`}
                        >
                          View public profile
                        </Link>
                      </div>
                    </div>

                    <div className="mt-4 border-t border-zinc-900 pt-4">
                      <h3 className="text-sm font-semibold text-zinc-100">
                        Student Requests
                      </h3>
                      <div className="mt-3 grid gap-2">
                        {relationships.length > 0 ? (
                          relationships.map((relationship) => (
                            <div
                              className="flex flex-col justify-between gap-3 border border-zinc-900 p-3 text-sm text-zinc-400 sm:flex-row sm:items-center"
                              key={relationship.id}
                            >
                              <div>
                                <div className="font-medium text-zinc-200">
                                  {relationship.userId}
                                </div>
                                <div className="mt-1 text-xs uppercase tracking-wide text-zinc-500">
                                  {relationship.status} / coach payment{" "}
                                  {relationship.coachPaymentStatus}
                                </div>
                              </div>
                              {relationship.status !== "active" ? (
                                <form action={confirmCoachPaymentAction}>
                                  <input
                                    name="relationshipId"
                                    type="hidden"
                                    value={relationship.id}
                                  />
                                  <button
                                    className="border border-emerald-800 px-3 py-2 text-sm text-emerald-300 hover:border-emerald-400"
                                    type="submit"
                                  >
                                    Activate
                                  </button>
                                </form>
                              ) : (
                                <Link
                                  className="text-sky-300 hover:text-sky-200"
                                  href={`/coach-dashboard?coachId=${encodeURIComponent(
                                    coach.id,
                                  )}`}
                                >
                                  Open dashboard
                                </Link>
                              )}
                            </div>
                          ))
                        ) : (
                          <p className="border border-zinc-900 p-3 text-sm text-zinc-500">
                            No student requests yet.
                          </p>
                        )}
                      </div>
                    </div>
                  </article>
                );
              })
            ) : (
              <div className="border border-zinc-800 bg-zinc-950 p-5">
                <h2 className="text-sm font-semibold text-zinc-100">
                  No coach profiles yet
                </h2>
                <p className="mt-2 text-sm text-zinc-500">
                  Create the first profile, then approve it to show it in the
                  public coach directory.
                </p>
              </div>
            )}
          </section>
        </section>

        <section className="border border-zinc-800 bg-zinc-950 p-5">
          <div className="flex flex-col justify-between gap-3 md:flex-row md:items-start">
            <div>
              <h2 className="text-sm font-semibold text-zinc-100">
                Payment Event Audit
              </h2>
              <p className="mt-2 max-w-3xl text-sm leading-6 text-zinc-500">
                Verified Whop webhook results appear here. Processed events
                grant Trader Intelligence app access; ignored events do not
                match the coach app-access payment purpose.
              </p>
            </div>
            <code className="border border-zinc-800 px-3 py-2 text-xs text-zinc-400">
              /api/real-coach/whop-webhook
            </code>
          </div>

          <div className="mt-4 grid gap-2">
            {paymentEvents.length > 0 ? (
              paymentEvents.map((event) => (
                <div
                  className="grid gap-2 border border-zinc-900 p-3 text-sm text-zinc-400 lg:grid-cols-[160px_minmax(0,1fr)_180px]"
                  key={event.id}
                >
                  <div>
                    <div
                      className={
                        event.status === "processed"
                          ? "text-emerald-300"
                          : event.status === "failed"
                            ? "text-rose-300"
                            : "text-zinc-500"
                      }
                    >
                      {event.status}
                    </div>
                    <div className="mt-1 text-xs text-zinc-600">
                      {event.eventType}
                    </div>
                  </div>
                  <div className="min-w-0">
                    <div className="truncate text-zinc-300">{event.message}</div>
                    <div className="mt-1 truncate text-xs text-zinc-600">
                      event {event.providerEventId}
                    </div>
                  </div>
                  <div className="text-xs text-zinc-600">
                    <div>{event.coachId ?? "no coach"}</div>
                    <div>{event.userId ?? "no user"}</div>
                  </div>
                </div>
              ))
            ) : (
              <p className="border border-zinc-900 p-3 text-sm text-zinc-500">
                No payment webhook events have been received yet.
              </p>
            )}
          </div>
        </section>
      </div>
    </main>
  );
}
