{
  "name": "trader-improvement-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "test:watch": "vitest",
    "audit:market-structure": "tsx src/scripts/audit-experimental-market-structure.ts",
    "calibrate:market-structure": "tsx src/scripts/audit-experimental-market-structure.ts --out-dir artifacts/market-structure-calibration",
    "debug:trade-analysis": "tsx src/scripts/debug-trade-analysis-request.ts",
    "compare:trade-debug": "tsx src/scripts/compare-trade-analysis-debug-runs.ts",
    "compare:levels-system": "tsx src/scripts/compare-levels-system-support-resistance.ts",
    "calibrate:decision-review": "tsx src/scripts/run-decision-review-quality-dashboard.ts",
    "build:ibkr-backfill-manifest": "tsx src/scripts/build-ibkr-warehouse-backfill-manifest.ts",
    "diagnose:ibkr-historical": "tsx src/scripts/diagnose-ibkr-historical-fetch.ts",
    "compare:actionable-sr-refresh": "tsx src/scripts/compare-actionable-sr-feedback-refresh.ts",
    "compare:final-exit-sr-refresh": "tsx src/scripts/compare-final-exit-sr-feedback-refresh.ts",
    "compare:entry-setup-refresh": "tsx src/scripts/compare-entry-setup-feedback-refresh.ts",
    "compare:vwap-refresh": "tsx src/scripts/compare-vwap-feedback-refresh.ts",
    "summarize:market-data-readiness": "tsx src/scripts/summarize-market-data-readiness.ts",
    "compare:decision-review-calibrations": "tsx src/scripts/compare-decision-review-calibrations.ts",
    "summarize:session-time-readiness": "tsx src/scripts/summarize-session-time-readiness.ts",
    "summarize:real-data-calibration-public": "tsx src/scripts/summarize-real-data-calibration-public.ts",
    "calibrate:saved-import": "tsx src/scripts/run-saved-import-calibration.ts",
    "validate:academy-registry": "node academy/_data/validate-academy-registry.mjs",
    "verify:levels-system": "vitest run src/lib/support-resistance/__tests__/levels-system-adapter.test.ts src/lib/support-resistance/__tests__/levels-system-comparison.test.ts src/lib/raw-trade-timeline/__tests__/levels-system-pattern-input.integration.test.ts src/lib/raw-trade-timeline/__tests__/levels-system-trade-candle-context.integration.test.ts src/lib/__tests__/trade-analysis-engine.levels-system.integration.test.ts src/lib/trade-analysis/__tests__/build-trade-analysis-summary.test.ts src/lib/trade-analysis/__tests__/classify-trade-analysis-failure.test.ts src/lib/trade-analysis/__tests__/compare-trade-analysis-debug-dashboards.test.ts src/lib/trade-analysis/__tests__/run-trade-analysis.test.ts src/lib/trade-analysis/__tests__/run-trade-analysis-batch.test.ts src/lib/trade-analysis/__tests__/trade-analysis-api-route.test.ts src/lib/trade-analysis/__tests__/trade-analysis-debug-dashboard.test.ts src/lib/trade-analysis/__tests__/trade-analysis-request-contract.test.ts src/lib/trade-analysis/__tests__/trade-analysis-request-fixtures.test.ts src/lib/trade-analysis/__tests__/trade-analysis-summary.snapshot.test.ts",
    "verify:layer2": "tsx src/scripts/verify-layer2-pattern-detection.ts",
    "verify:layer3": "tsx src/scripts/verify-layer3-pattern-normalization.ts",
    "verify:all": "npm test && npm run verify:levels-system && npm run verify:layer2 && npm run verify:layer3",
    "check": "tsc --noEmit && npm run build"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@mui/material-nextjs": "^9.0.1",
    "@stoqey/ib": "^1.5.6",
    "@types/better-sqlite3": "^7.6.13",
    "@whop/sdk": "^0.0.40",
    "better-sqlite3": "^12.9.0",
    "levels-system-v2": "file:../levels-system",
    "next": "16.2.3",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "overrides": {
    "postcss": "8.5.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}
