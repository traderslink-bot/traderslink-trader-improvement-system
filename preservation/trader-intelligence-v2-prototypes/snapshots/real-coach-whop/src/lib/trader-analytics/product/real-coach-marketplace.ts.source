function metadataString(
  metadata: Record<string, unknown> | null,
  ...keys: string[]
): string | null {
  if (!metadata) {
    return null;
  }

  for (const key of keys) {
    const value = metadata[key];
    if (typeof value === "string" && value.trim()) {
      return value.trim();
    }
  }

  return null;
}

function stableJson(value: unknown): string {
  try {
    return JSON.stringify(value);
  } catch {
    return JSON.stringify({ unserializable: true });
  }
}

export function runRealCoachMarketplaceMigrations(
  db: RealCoachMarketplaceDatabase,
): void {
  db.exec(`
    CREATE TABLE IF NOT EXISTS coach_profiles (
      id TEXT PRIMARY KEY,
      slug TEXT NOT NULL UNIQUE,
      display_name TEXT NOT NULL,
      headline TEXT NOT NULL,
      bio TEXT NOT NULL,
      specialties_json TEXT NOT NULL,
      social_links_json TEXT NOT NULL,
      whop_url TEXT NOT NULL,
      app_access_fee_text TEXT NOT NULL,
      coach_fee_text TEXT NOT NULL,
      student_cap INTEGER NOT NULL,
      status TEXT NOT NULL,
      created_at TEXT NOT NULL,
      updated_at TEXT NOT NULL
    );

    CREATE INDEX IF NOT EXISTS coach_profiles_status_idx
      ON coach_profiles(status);

    CREATE TABLE IF NOT EXISTS coach_access_passes (
      id TEXT PRIMARY KEY,
      coach_id TEXT NOT NULL,
      user_id TEXT NOT NULL,
      workspace_id TEXT NOT NULL,
      account_id TEXT NOT NULL,
      status TEXT NOT NULL,
      app_fee_text TEXT NOT NULL,
      paid_at TEXT NOT NULL,
      expires_at TEXT NOT NULL,
      payment_reference TEXT NOT NULL,
      created_at TEXT NOT NULL,
      updated_at TEXT NOT NULL
    );

    CREATE INDEX IF NOT EXISTS coach_access_passes_user_coach_idx
      ON coach_access_passes(user_id, coach_id, expires_at);

    CREATE TABLE IF NOT EXISTS coach_student_relationships (
      id TEXT PRIMARY KEY,
      coach_id TEXT NOT NULL,
      user_id TEXT NOT NULL,
      workspace_id TEXT NOT NULL,
      account_id TEXT NOT NULL,
      access_pass_id TEXT NOT NULL,
      status TEXT NOT NULL,
      coach_payment_status TEXT NOT NULL,
      requested_at TEXT NOT NULL,
      consented_at TEXT NOT NULL,
      activated_at TEXT,
      expires_at TEXT NOT NULL,
      ended_at TEXT,
      created_at TEXT NOT NULL,
      updated_at TEXT NOT NULL
    );

    CREATE INDEX IF NOT EXISTS coach_student_relationships_coach_status_idx
      ON coach_student_relationships(coach_id, status, expires_at);

    CREATE INDEX IF NOT EXISTS coach_student_relationships_user_status_idx
      ON coach_student_relationships(user_id, status, expires_at);

    DROP INDEX IF EXISTS coach_student_relationships_active_unique;

    CREATE TABLE IF NOT EXISTS coach_private_notes (
      id TEXT PRIMARY KEY,
      relationship_id TEXT NOT NULL,
      coach_id TEXT NOT NULL,
      user_id TEXT NOT NULL,
      title TEXT NOT NULL,
      body TEXT NOT NULL,
      created_at TEXT NOT NULL,
      updated_at TEXT NOT NULL
    );

    CREATE INDEX IF NOT EXISTS coach_private_notes_relationship_idx
      ON coach_private_notes(relationship_id, created_at);

    CREATE TABLE IF NOT EXISTS coach_feedback_reports (
      id TEXT PRIMARY KEY,
      relationship_id TEXT NOT NULL,
      coach_id TEXT NOT NULL,
      user_id TEXT NOT NULL,
      kind TEXT NOT NULL,
      status TEXT NOT NULL,
      period_label TEXT NOT NULL,
      title TEXT NOT NULL,
      body TEXT NOT NULL,
      published_at TEXT,
      created_at TEXT NOT NULL,
      updated_at TEXT NOT NULL
    );

    CREATE INDEX IF NOT EXISTS coach_feedback_reports_relationship_status_idx
      ON coach_feedback_reports(relationship_id, status, created_at);

    CREATE TABLE IF NOT EXISTS coach_action_items (
      id TEXT PRIMARY KEY,
      relationship_id TEXT NOT NULL,
      coach_id TEXT NOT NULL,
      user_id TEXT NOT NULL,
      report_id TEXT,
      title TEXT NOT NULL,
      body TEXT NOT NULL,
      due_label TEXT NOT NULL,
      status TEXT NOT NULL,
      completed_at TEXT,
      created_at TEXT NOT NULL,
      updated_at TEXT NOT NULL
    );

    CREATE INDEX IF NOT EXISTS coach_action_items_relationship_status_idx
      ON coach_action_items(relationship_id, status, created_at);

    CREATE TABLE IF NOT EXISTS coach_payment_events (
      id TEXT PRIMARY KEY,
      provider TEXT NOT NULL,
      provider_event_id TEXT NOT NULL,
      provider_payment_id TEXT,
      event_type TEXT NOT NULL,
      coach_id TEXT,
      user_id TEXT,
      workspace_id TEXT,
      account_id TEXT,
      status TEXT NOT NULL,
      message TEXT NOT NULL,
      access_pass_id TEXT,
      raw_json TEXT NOT NULL,
      received_at TEXT NOT NULL,
      created_at TEXT NOT NULL
    );

    CREATE UNIQUE INDEX IF NOT EXISTS coach_payment_events_provider_event_idx
      ON coach_payment_events(provider, provider_event_id);

    CREATE INDEX IF NOT EXISTS coach_payment_events_coach_user_idx
      ON coach_payment_events(coach_id, user_id, created_at);
  `);
}

export class RealCoachMarketplaceRepository {
  private readonly db: RealCoachMarketplaceDatabase;

  constructor(db: RealCoachMarketplaceDatabase = getTraderIntelligenceDatabase()) {
    this.db = db;
    runRealCoachMarketplaceMigrations(this.db);
  }

  createCoachProfile(input: {
    displayName: string;
    headline: string;
    bio: string;
    specialtiesText?: string;
    socialLinksText?: string;
    whopUrl: string;
    appAccessFeeText: string;
    coachFeeText: string;
    studentCap: number;
    status?: RealCoachProfileStatus;
    createdAt?: string;
  }): RealCoachProfile {
    const createdAt = input.createdAt ?? nowIso();
    const profile: RealCoachProfile = {
      id: compactId("coach"),
      slug: slugify(input.displayName),
      displayName: input.displayName.trim(),
      headline: input.headline.trim(),
      bio: input.bio.trim(),
      specialties: splitList(input.specialtiesText ?? ""),
      socialLinks: parseSocialLinks(input.socialLinksText ?? ""),
      whopUrl: input.whopUrl.trim(),
      appAccessFeeText: input.appAccessFeeText.trim() || "$49 / month access",
      coachFeeText: input.coachFeeText.trim() || "Coach sets fee on Whop",
      studentCap: Math.max(0, Math.floor(input.studentCap)),
      status: input.status ?? "draft",
      createdAt,
      updatedAt: createdAt,
    };

    this.db
      .prepare(
        `INSERT INTO coach_profiles (
          id, slug, display_name, headline, bio, specialties_json,
          social_links_json, whop_url, app_access_fee_text, coach_fee_text,
          student_cap, status, created_at, updated_at
        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
      )
      .run(
        profile.id,
        profile.slug,
        profile.displayName,
        profile.headline,
        profile.bio,
        JSON.stringify(profile.specialties),
        JSON.stringify(profile.socialLinks),
        profile.whopUrl,
        profile.appAccessFeeText,
        profile.coachFeeText,
        profile.studentCap,
        profile.status,
        profile.createdAt,
        profile.updatedAt,
      );

    return profile;
  }

  updateCoachStatus(input: {
    coachId: string;
    status: RealCoachProfileStatus;
    updatedAt?: string;
  }): RealCoachProfile | null {
    const updatedAt = input.updatedAt ?? nowIso();
    this.db
      .prepare(
        `UPDATE coach_profiles
         SET status = ?, updated_at = ?
         WHERE id = ?`,
      )
      .run(input.status, updatedAt, input.coachId);

    return this.getCoachProfile(input.coachId);
  }

  updateCoachCapacity(input: {
    coachId: string;
    studentCap: number;
    updatedAt?: string;
  }): RealCoachProfile | null {
    const updatedAt = input.updatedAt ?? nowIso();
    this.db
      .prepare(
        `UPDATE coach_profiles
         SET student_cap = ?, updated_at = ?
         WHERE id = ?`,
      )
      .run(Math.max(0, Math.floor(input.studentCap)), updatedAt, input.coachId);

    return this.getCoachProfile(input.coachId);
  }

  ensurePrototypeSeedCoach(input?: { createdAt?: string }): RealCoachProfile {
    const existing = this.getCoachProfile(PROTOTYPE_SEED_COACH_SLUG);
    if (existing) {
      const needsSeedCopyRefresh =
        existing.bio.includes("prototype approved") ||
        existing.bio.includes("system coach") ||
        existing.bio !== AVERY_CHEN_SEED_BIO;

      if (needsSeedCopyRefresh) {
        const updatedAt = input?.createdAt ?? nowIso();
        this.db
          .prepare(
            `UPDATE coach_profiles
             SET bio = ?, updated_at = ?
             WHERE id = ?`,
          )
          .run(AVERY_CHEN_SEED_BIO, updatedAt, existing.id);
      }

      return existing.status === "approved" && !needsSeedCopyRefresh
        ? existing
        : (this.updateCoachStatus({
            coachId: existing.id,
            status: "approved",
            updatedAt: input?.createdAt,
          }) ?? existing);
    }

    return this.createCoachProfile({
      displayName: "Avery Chen",
      headline: "Weekly execution reviews for momentum and small-cap traders.",
      bio: AVERY_CHEN_SEED_BIO,
      specialtiesText: [
        "entry discipline",
        "adds and scaling",
        "profit protection",
        "weekly trade review",
      ].join(", "),
      socialLinksText: [
        "YouTube | https://example.com/avery-trading",
        "X | https://example.com/avery-x",
      ].join("\n"),
      whopUrl: "https://whop.com/trader-intelligence-coach-demo",
      appAccessFeeText: "$49 / one-month coach access",
      coachFeeText: "$300 / month through coach-owned Whop",
      studentCap: 12,
      status: "approved",
      createdAt: input?.createdAt,
    });
  }

  listCoachProfiles(): RealCoachProfile[] {
    return this.db
      .prepare(
        `SELECT *
         FROM coach_profiles
         ORDER BY status = 'approved' DESC, display_name ASC`,
      )
      .all()
      .map((row) => toProfile(row as CoachProfileRow));
  }

  listApprovedCoachDirectory(now = nowIso()): CoachDirectoryCard[] {
    return this.db
      .prepare(
        `SELECT *
         FROM coach_profiles
         WHERE status = 'approved'
         ORDER BY display_name ASC`,
      )
      .all()
      .map((row) => this.buildDirectoryCard(toProfile(row as CoachProfileRow), now));
  }

  getCoachProfile(coachIdOrSlug: string): RealCoachProfile | null {
    const row = this.db
      .prepare(
        `SELECT *
         FROM coach_profiles
         WHERE id = ? OR slug = ?
         LIMIT 1`,
      )
      .get(coachIdOrSlug, coachIdOrSlug) as CoachProfileRow | undefined;

    return row ? toProfile(row) : null;
  }

  buildDirectoryCard(coach: RealCoachProfile, now = nowIso()): CoachDirectoryCard {
    const activeStudentCount = this.countRelationships({
      coachId: coach.id,
      statuses: ["active"],
      now,
    });
    const reservedStudentCount = this.countRelationships({
      coachId: coach.id,
      statuses: ["requested", "active"],
      now,
    });
    const availableSeatCount = Math.max(0, coach.studentCap - reservedStudentCount);

    return {
      coach,
      activeStudentCount,
      reservedStudentCount,
      availableSeatCount,
      requestsDisabled:
        coach.status !== "approved" ||
        coach.studentCap <= 0 ||
        availableSeatCount <= 0,
    };
  }

  grantPrototypeAppAccessPass(input: {
    coachId: string;
    userId?: TraderAnalyticsUserId;
    workspaceId?: string;
    accountId?: string;
    paymentReference?: string;
    paidAt?: string;
  }): CoachAccessPass {
    const coach = this.requireCoach(input.coachId);
    const paidAt = input.paidAt ?? nowIso();
    const pass: CoachAccessPass = {
      id: compactId("coach_access"),
      coachId: coach.id,
      userId: input.userId ?? DEMO_USER_ID,
      workspaceId: input.workspaceId ?? DEMO_WORKSPACE_ID,
      accountId: input.accountId ?? DEMO_ACCOUNT_ID,
      status: "paid",
      appFeeText: coach.appAccessFeeText,
      paidAt,
      expiresAt: monthFrom(paidAt, 1),
      paymentReference:
        input.paymentReference?.trim() ||
        `prototype-app-access:${coach.slug}:${paidAt}`,
      createdAt: paidAt,
      updatedAt: paidAt,
    };

    this.db
      .prepare(
        `INSERT INTO coach_access_passes (
          id, coach_id, user_id, workspace_id, account_id, status,
          app_fee_text, paid_at, expires_at, payment_reference,
          created_at, updated_at
        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
      )
      .run(
        pass.id,
        pass.coachId,
        pass.userId,
        pass.workspaceId,
        pass.accountId,
        pass.status,
        pass.appFeeText,
        pass.paidAt,
        pass.expiresAt,
        pass.paymentReference,
        pass.createdAt,
        pass.updatedAt,
      );

    return pass;
  }

  processWhopAppAccessPayment(
    input: ProcessWhopAppAccessPaymentInput,
  ): ProcessWhopAppAccessPaymentResult {
    const receivedAt = input.receivedAt ?? nowIso();
    const providerEventId = input.providerEventId.trim();
    const rawJson = stableJson(input.rawEvent);
    const existing = this.getPaymentEvent({
      provider: "whop",
      providerEventId,
    });

    if (existing) {
      return {
        status: "duplicate",
        message: "Webhook event was already recorded.",
        event: existing,
        accessPass: existing.accessPassId
          ? this.getAccessPass(existing.accessPassId)
          : null,
      };
    }

    const providerPaymentId = input.providerPaymentId?.trim() || null;
    const purpose = metadataString(
      input.metadata,
      "purpose",
      "paymentPurpose",
      "payment_purpose",
    );
    const coachId = metadataString(input.metadata, "coachId", "coach_id");
    const userId = metadataString(input.metadata, "userId", "user_id");
    const workspaceId = metadataString(
      input.metadata,
      "workspaceId",
      "workspace_id",
    );
    const accountId = metadataString(input.metadata, "accountId", "account_id");

    if (input.eventType !== "payment.succeeded") {
      return {
        status: "ignored",
        message: `Ignored unsupported Whop event type: ${input.eventType}.`,
        event: this.insertPaymentEvent({
          providerEventId,
          providerPaymentId,
          eventType: input.eventType,
          coachId,
          userId,
          workspaceId,
          accountId,
          status: "ignored",
          message: `Ignored unsupported Whop event type: ${input.eventType}.`,
          accessPassId: null,
          rawJson,
          receivedAt,
        }),
        accessPass: null,
      };
    }

    if (purpose !== COACH_APP_ACCESS_PAYMENT_PURPOSE) {
      return {
        status: "ignored",
        message: "Ignored Whop payment because it is not a coach app-access payment.",
        event: this.insertPaymentEvent({
          providerEventId,
          providerPaymentId,
          eventType: input.eventType,
          coachId,
          userId,
          workspaceId,
          accountId,
          status: "ignored",
          message:
            "Ignored Whop payment because it is not a coach app-access payment.",
          accessPassId: null,
          rawJson,
          receivedAt,
        }),
        accessPass: null,
      };
    }

    if (!coachId || !userId || !workspaceId || !accountId) {
      return {
        status: "failed",
        message:
          "Whop coach app-access payment is missing coachId, userId, workspaceId, or accountId metadata.",
        event: this.insertPaymentEvent({
          providerEventId,
          providerPaymentId,
          eventType: input.eventType,
          coachId,
          userId,
          workspaceId,
          accountId,
          status: "failed",
          message:
            "Whop coach app-access payment is missing coachId, userId, workspaceId, or accountId metadata.",
          accessPassId: null,
          rawJson,
          receivedAt,
        }),
        accessPass: null,
      };
    }

    const coach = this.getCoachProfile(coachId);
    if (!coach || coach.status !== "approved") {
      return {
        status: "failed",
        message: "Whop coach app-access payment references an unapproved coach.",
        event: this.insertPaymentEvent({
          providerEventId,
          providerPaymentId,
          eventType: input.eventType,
          coachId,
          userId,
          workspaceId,
          accountId,
          status: "failed",
          message: "Whop coach app-access payment references an unapproved coach.",
          accessPassId: null,
          rawJson,
          receivedAt,
        }),
        accessPass: null,
      };
    }

    const accessPass = this.grantPrototypeAppAccessPass({
      coachId: coach.id,
      userId,
      workspaceId,
      accountId,
      paymentReference: providerPaymentId
        ? `whop:${providerPaymentId}`
        : `whop-event:${providerEventId}`,
      paidAt: input.paidAt ?? receivedAt,
    });
    const message = "Whop payment succeeded; coach app access pass granted.";

    return {
      status: "processed",
      message,
      event: this.insertPaymentEvent({
        providerEventId,
        providerPaymentId,
        eventType: input.eventType,
        coachId: coach.id,
        userId,
        workspaceId,
        accountId,
        status: "processed",
        message,
        accessPassId: accessPass.id,
        rawJson,
        receivedAt,
      }),
      accessPass,
    };
  }

  listPaymentEvents(limit = 25): CoachPaymentEvent[] {
    return this.db
      .prepare(
        `SELECT *
         FROM coach_payment_events
         ORDER BY created_at DESC
         LIMIT ?`,
      )
      .all(Math.max(1, Math.floor(limit)))
      .map((row) => toPaymentEvent(row as CoachPaymentEventRow));
  }

  getActiveAccessPass(input: {
    coachId: string;
    userId?: TraderAnalyticsUserId;
    now?: string;
  }): CoachAccessPass | null {
    const now = input.now ?? nowIso();
    const row = this.db
      .prepare(
        `SELECT *
         FROM coach_access_passes
         WHERE coach_id = ?
           AND user_id = ?
           AND status = 'paid'
           AND expires_at > ?
         ORDER BY expires_at DESC
         LIMIT 1`,
      )
      .get(input.coachId, input.userId ?? DEMO_USER_ID, now) as
      | CoachAccessPassRow
      | undefined;

    return row ? toPass(row) : null;
  }

  private getAccessPass(accessPassId: string): CoachAccessPass | null {
    const row = this.db
      .prepare(
        `SELECT *
         FROM coach_access_passes
         WHERE id = ?
         LIMIT 1`,
      )
      .get(accessPassId) as CoachAccessPassRow | undefined;

    return row ? toPass(row) : null;
  }

  requestCoach(input: {
    coachId: string;
    userId?: TraderAnalyticsUserId;
    workspaceId?: string;
    accountId?: string;
    now?: string;
  }): { relationship: CoachStudentRelationship | null; reason?: string } {
    const requestedAt = input.now ?? nowIso();
    const userId = input.userId ?? DEMO_USER_ID;
    const coach = this.getCoachProfile(input.coachId);

    if (!coach || coach.status !== "approved") {
      return { relationship: null, reason: "coach_not_approved" };
    }

    const card = this.buildDirectoryCard(coach, requestedAt);
    if (card.requestsDisabled) {
      return { relationship: null, reason: "coach_capacity_full" };
    }

    const existing = this.getCurrentRelationship({
      coachId: coach.id,
      userId,
      now: requestedAt,
    });
    if (existing) {
      return { relationship: existing };
    }

    const accessPass = this.getActiveAccessPass({
      coachId: coach.id,
      userId,
      now: requestedAt,
    });
    if (!accessPass) {
      return { relationship: null, reason: "app_access_fee_required" };
    }

    const relationship: CoachStudentRelationship = {
      id: compactId("coach_student"),
      coachId: coach.id,
      userId,
      workspaceId: input.workspaceId ?? accessPass.workspaceId,
      accountId: input.accountId ?? accessPass.accountId,
      accessPassId: accessPass.id,
      status: "requested",
      coachPaymentStatus: "pending",
      requestedAt,
      consentedAt: requestedAt,
      activatedAt: null,
      expiresAt: accessPass.expiresAt,
      endedAt: null,
      createdAt: requestedAt,
      updatedAt: requestedAt,
    };

    this.db
      .prepare(
        `INSERT INTO coach_student_relationships (
          id, coach_id, user_id, workspace_id, account_id, access_pass_id,
          status, coach_payment_status, requested_at, consented_at,
          activated_at, expires_at, ended_at, created_at, updated_at
        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
      )
      .run(
        relationship.id,
        relationship.coachId,
        relationship.userId,
        relationship.workspaceId,
        relationship.accountId,
        relationship.accessPassId,
        relationship.status,
        relationship.coachPaymentStatus,
        relationship.requestedAt,
        relationship.consentedAt,
        relationship.activatedAt,
        relationship.expiresAt,
        relationship.endedAt,
        relationship.createdAt,
        relationship.updatedAt,
      );

    return { relationship };
  }

  confirmCoachPayment(input: {
    relationshipId: string;
    confirmedAt?: string;
  }): CoachStudentRelationship | null {
    const confirmedAt = input.confirmedAt ?? nowIso();
    this.db
      .prepare(
        `UPDATE coach_student_relationships
         SET status = 'active',
             coach_payment_status = 'confirmed',
             activated_at = COALESCE(activated_at, ?),
             updated_at = ?
         WHERE id = ?
           AND status IN ('requested', 'active')`,
      )
      .run(confirmedAt, confirmedAt, input.relationshipId);

    return this.getRelationship(input.relationshipId);
  }

  listRelationshipsForCoach(input: {
    coachId: string;
    includeEnded?: boolean;
  }): CoachStudentRelationship[] {
    const rows = input.includeEnded
      ? this.db
          .prepare(
            `SELECT *
             FROM coach_student_relationships
             WHERE coach_id = ?
             ORDER BY requested_at DESC`,
          )
          .all(input.coachId)
      : this.db
          .prepare(
            `SELECT *
             FROM coach_student_relationships
             WHERE coach_id = ?
               AND status IN ('requested', 'active')
             ORDER BY requested_at DESC`,
          )
          .all(input.coachId);

    return rows.map((row) => toRelationship(row as CoachRelationshipRow));
  }

  listStudentCoachViews(input: {
    userId?: TraderAnalyticsUserId;
  } = {}): StudentCoachView[] {
    const userId = input.userId ?? DEMO_USER_ID;
    return this.db
      .prepare(
        `SELECT *
         FROM coach_student_relationships
         WHERE user_id = ?
           AND status IN ('requested', 'active')
         ORDER BY requested_at DESC`,
      )
      .all(userId)
      .map((row) => toRelationship(row as CoachRelationshipRow))
      .flatMap((relationship) => {
        const coach = this.getCoachProfile(relationship.coachId);
        if (!coach) {
          return [];
        }

        return [
          {
            relationship,
            coach,
            reports: this.listPublishedReports(relationship.id),
            actionItems: this.listActionItems(relationship.id),
          },
        ];
      });
  }

  getCoachStudentReadModel(input: {
    relationshipId: string;
    coachId: string;
    trades: SavedExecutionTrade[];
    reports: SavedTraderAnalyticsReport[];
    now?: string;
  }): CoachStudentReadModel | null {
    const now = input.now ?? nowIso();
    const relationship = this.getRelationship(input.relationshipId);

    if (
      !relationship ||
      relationship.coachId !== input.coachId ||
      relationship.status !== "active" ||
      relationship.expiresAt <= now
    ) {
      return null;
    }

    const coach = this.getCoachProfile(relationship.coachId);
    if (!coach) {
      return null;
    }

    return {
      relationship,
      coach,
      trades: input.trades.filter((trade) => trade.userId === relationship.userId),
      latestReport:
        input.reports
          .filter((report) => report.userId === relationship.userId)
          .sort((a, b) => b.generatedAt.localeCompare(a.generatedAt))[0] ?? null,
      actionItems: this.listActionItems(relationship.id),
    };
  }

  addPrivateNote(input: {
    relationshipId: string;
    coachId: string;
    title: string;
    body: string;
    createdAt?: string;
  }): CoachPrivateNote | null {
    const relationship = this.getRelationship(input.relationshipId);
    if (!relationship || relationship.coachId !== input.coachId) {
      return null;
    }

    const createdAt = input.createdAt ?? nowIso();
    const note: CoachPrivateNote = {
      id: compactId("coach_note"),
      relationshipId: relationship.id,
      coachId: relationship.coachId,
      userId: relationship.userId,
      title: input.title.trim(),
      body: input.body.trim(),
      createdAt,
      updatedAt: createdAt,
    };

    this.db
      .prepare(
        `INSERT INTO coach_private_notes (
          id, relationship_id, coach_id, user_id, title, body,
          created_at, updated_at
        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?)`,
      )
      .run(
        note.id,
        note.relationshipId,
        note.coachId,
        note.userId,
        note.title,
        note.body,
        note.createdAt,
        note.updatedAt,
      );

    return note;
  }

  listPrivateNotes(relationshipId: string): CoachPrivateNote[] {
    return this.db
      .prepare(
        `SELECT *
         FROM coach_private_notes
         WHERE relationship_id = ?
         ORDER BY created_at DESC`,
      )
      .all(relationshipId)
      .map((row) => toPrivateNote(row as CoachPrivateNoteRow));
  }

  createFeedbackReport(input: {
    relationshipId: string;
    coachId: string;
    kind: CoachFeedbackKind;
    periodLabel: string;
    title: string;
    body: string;
    publish?: boolean;
    createdAt?: string;
  }): CoachFeedbackReport | null {
    const relationship = this.getRelationship(input.relationshipId);
    if (!relationship || relationship.coachId !== input.coachId) {
      return null;
    }

    const createdAt = input.createdAt ?? nowIso();
    const status: CoachFeedbackStatus = input.publish ? "published" : "draft";
    const report: CoachFeedbackReport = {
      id: compactId("coach_report"),
      relationshipId: relationship.id,
      coachId: relationship.coachId,
      userId: relationship.userId,
      kind: input.kind,
      status,
      periodLabel: input.periodLabel.trim(),
      title: input.title.trim(),
      body: input.body.trim(),
      publishedAt: status === "published" ? createdAt : null,
      createdAt,
      updatedAt: createdAt,
    };

    this.db
      .prepare(
        `INSERT INTO coach_feedback_reports (
          id, relationship_id, coach_id, user_id, kind, status, period_label,
          title, body, published_at, created_at, updated_at
        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
      )
      .run(
        report.id,
        report.relationshipId,
        report.coachId,
        report.userId,
        report.kind,
        report.status,
        report.periodLabel,
        report.title,
        report.body,
        report.publishedAt,
        report.createdAt,
        report.updatedAt,
      );

    return report;
  }

  listPublishedReports(relationshipId: string): CoachFeedbackReport[] {
    return this.db
      .prepare(
        `SELECT *
         FROM coach_feedback_reports
         WHERE relationship_id = ?
           AND status = 'published'
         ORDER BY published_at DESC, created_at DESC`,
      )
      .all(relationshipId)
      .map((row) => toFeedbackReport(row as CoachFeedbackReportRow));
  }

  listCoachReports(relationshipId: string): CoachFeedbackReport[] {
    return this.db
      .prepare(
        `SELECT *
         FROM coach_feedback_reports
         WHERE relationship_id = ?
         ORDER BY created_at DESC`,
      )
      .all(relationshipId)
      .map((row) => toFeedbackReport(row as CoachFeedbackReportRow));
  }

  createActionItem(input: {
    relationshipId: string;
    coachId: string;
    reportId?: string | null;
    title: string;
    body: string;
    dueLabel: string;
    createdAt?: string;
  }): CoachActionItem | null {
    const relationship = this.getRelationship(input.relationshipId);
    if (!relationship || relationship.coachId !== input.coachId) {
      return null;
    }

    const createdAt = input.createdAt ?? nowIso();
    const actionItem: CoachActionItem = {
      id: compactId("coach_action"),
      relationshipId: relationship.id,
      coachId: relationship.coachId,
      userId: relationship.userId,
      reportId: input.reportId ?? null,
      title: input.title.trim(),
      body: input.body.trim(),
      dueLabel: input.dueLabel.trim(),
      status: "assigned",
      completedAt: null,
      createdAt,
      updatedAt: createdAt,
    };

    this.db
      .prepare(
        `INSERT INTO coach_action_items (
          id, relationship_id, coach_id, user_id, report_id, title, body,
          due_label, status, completed_at, created_at, updated_at
        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
      )
      .run(
        actionItem.id,
        actionItem.relationshipId,
        actionItem.coachId,
        actionItem.userId,
        actionItem.reportId,
        actionItem.title,
        actionItem.body,
        actionItem.dueLabel,
        actionItem.status,
        actionItem.completedAt,
        actionItem.createdAt,
        actionItem.updatedAt,
      );

    return actionItem;
  }

  completeActionItem(input: {
    actionItemId: string;
    userId?: TraderAnalyticsUserId;
    completedAt?: string;
  }): CoachActionItem | null {
    const completedAt = input.completedAt ?? nowIso();
    this.db
      .prepare(
        `UPDATE coach_action_items
         SET status = 'completed',
             completed_at = ?,
             updated_at = ?
         WHERE id = ?
           AND user_id = ?`,
      )
      .run(completedAt, completedAt, input.actionItemId, input.userId ?? DEMO_USER_ID);

    return this.getActionItem(input.actionItemId);
  }

  listActionItems(relationshipId: string): CoachActionItem[] {
    return this.db
      .prepare(
        `SELECT *
         FROM coach_action_items
         WHERE relationship_id = ?
         ORDER BY status = 'assigned' DESC, created_at DESC`,
      )
      .all(relationshipId)
      .map((row) => toActionItem(row as CoachActionItemRow));
  }

  getRelationship(relationshipId: string): CoachStudentRelationship | null {
    const row = this.db
      .prepare(
        `SELECT *
         FROM coach_student_relationships
         WHERE id = ?
         LIMIT 1`,
      )
      .get(relationshipId) as CoachRelationshipRow | undefined;

    return row ? toRelationship(row) : null;
  }

  getCurrentRelationship(input: {
    coachId: string;
    userId?: TraderAnalyticsUserId;
    now?: string;
  }): CoachStudentRelationship | null {
    const now = input.now ?? nowIso();
    const row = this.db
      .prepare(
        `SELECT *
         FROM coach_student_relationships
         WHERE coach_id = ?
           AND user_id = ?
           AND status IN ('requested', 'active')
           AND expires_at > ?
         ORDER BY requested_at DESC
         LIMIT 1`,
      )
      .get(input.coachId, input.userId ?? DEMO_USER_ID, now) as
      | CoachRelationshipRow
      | undefined;

    return row ? toRelationship(row) : null;
  }

  private getActionItem(actionItemId: string): CoachActionItem | null {
    const row = this.db
      .prepare(
        `SELECT *
         FROM coach_action_items
         WHERE id = ?
         LIMIT 1`,
      )
      .get(actionItemId) as CoachActionItemRow | undefined;

    return row ? toActionItem(row) : null;
  }

  private getPaymentEvent(input: {
    provider: "whop";
    providerEventId: string;
  }): CoachPaymentEvent | null {
    const row = this.db
      .prepare(
        `SELECT *
         FROM coach_payment_events
         WHERE provider = ?
           AND provider_event_id = ?
         LIMIT 1`,
      )
      .get(input.provider, input.providerEventId) as
      | CoachPaymentEventRow
      | undefined;

    return row ? toPaymentEvent(row) : null;
  }

  private insertPaymentEvent(input: {
    providerEventId: string;
    providerPaymentId: string | null;
    eventType: string;
    coachId: string | null;
    userId: TraderAnalyticsUserId | null;
    workspaceId: string | null;
    accountId: string | null;
    status: CoachPaymentEventStatus;
    message: string;
    accessPassId: string | null;
    rawJson: string;
    receivedAt: string;
  }): CoachPaymentEvent {
    const createdAt = input.receivedAt;
    const event: CoachPaymentEvent = {
      id: compactId("coach_payment_event"),
      provider: "whop",
      providerEventId: input.providerEventId,
      providerPaymentId: input.providerPaymentId,
      eventType: input.eventType,
      coachId: input.coachId,
      userId: input.userId,
      workspaceId: input.workspaceId,
      accountId: input.accountId,
      status: input.status,
      message: input.message,
      accessPassId: input.accessPassId,
      rawJson: input.rawJson,
      receivedAt: input.receivedAt,
      createdAt,
    };

    this.db
      .prepare(
        `INSERT INTO coach_payment_events (
          id, provider, provider_event_id, provider_payment_id, event_type,
          coach_id, user_id, workspace_id, account_id, status, message,
          access_pass_id, raw_json, received_at, created_at
        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
      )
      .run(
        event.id,
        event.provider,
        event.providerEventId,
        event.providerPaymentId,
        event.eventType,
        event.coachId,
        event.userId,
        event.workspaceId,
        event.accountId,
        event.status,
        event.message,
        event.accessPassId,
        event.rawJson,
        event.receivedAt,
        event.createdAt,
      );

    return event;
  }

  private countRelationships(input: {
    coachId: string;
    statuses: CoachRelationshipStatus[];
    now: string;
  }): number {
    const placeholders = input.statuses.map(() => "?").join(", ");
    const row = this.db
      .prepare(
        `SELECT COUNT(*) AS count
         FROM coach_student_relationships
         WHERE coach_id = ?
           AND status IN (${placeholders})
           AND expires_at > ?`,
      )
      .get(input.coachId, ...input.statuses, input.now) as
      | { count: number }
      | undefined;

    return Number(row?.count ?? 0);
  }

  private requireCoach(coachId: string): RealCoachProfile {
    const coach = this.getCoachProfile(coachId);
    if (!coach) {
      throw new Error(`Coach profile not found: ${coachId}`);
    }

    return coach;
  }
}

export function createRealCoachMarketplaceRepository(): RealCoachMarketplaceRepository {
  return new RealCoachMarketplaceRepository();
}
