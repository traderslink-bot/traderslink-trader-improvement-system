function nowIso(now = new Date()): string {
  return now.toISOString();
}

function monthFrom(value: string, months: number): string {
  const date = new Date(value);
  date.setUTCMonth(date.getUTCMonth() + months);
  return date.toISOString();
}

function compactId(prefix: string): string {
  return `${prefix}_${crypto.randomUUID()}`;
}

function slugify(value: string): string {
  const slug = value
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

  return slug || `coach-${crypto.randomUUID().slice(0, 8)}`;
}

function parseJsonArray<T>(value: string, fallback: T[]): T[] {
  try {
    const parsed = JSON.parse(value);
    return Array.isArray(parsed) ? (parsed as T[]) : fallback;
  } catch {
    return fallback;
  }
}

function splitList(value: string): string[] {
  return value
    .split(/\r?\n|,/)
    .map((item) => item.trim())
    .filter(Boolean);
}

function parseSocialLinks(value: string): CoachSocialLink[] {
  return value
    .split(/\r?\n/)
    .map((line) => line.trim())
    .filter(Boolean)
    .map((line) => {
      const [label, ...urlParts] = line.split("|");
      const url = urlParts.join("|").trim();
      return {
        label: (label ?? "").trim() || "Social",
        url: url || (label ?? "").trim(),
      };
    })
    .filter((link) => link.url.length > 0);
}

function toProfile(row: CoachProfileRow): RealCoachProfile {
  const isAverySeed = row.slug === PROTOTYPE_SEED_COACH_SLUG;

  return {
    id: row.id,
    slug: row.slug,
    displayName: row.display_name,
    headline: row.headline,
    bio: isAverySeed ? AVERY_CHEN_SEED_BIO : row.bio,
    specialties: parseJsonArray<string>(row.specialties_json, []),
    socialLinks: parseJsonArray<CoachSocialLink>(row.social_links_json, []),
    whopUrl: row.whop_url,
    appAccessFeeText: row.app_access_fee_text,
    coachFeeText: row.coach_fee_text,
    studentCap: row.student_cap,
    status: row.status,
    createdAt: row.created_at,
    updatedAt: row.updated_at,
  };
}

