export type CoachAccessPassStatus = "paid" | "refunded" | "expired";
export type CoachRelationshipStatus = "requested" | "active" | "ended";
export type CoachPaymentStatus = "pending" | "confirmed" | "cancelled";
export type CoachFeedbackKind = "weekly" | "monthly";
export type CoachFeedbackStatus = "draft" | "published";
export type CoachActionItemStatus = "assigned" | "completed";
export type CoachPaymentEventStatus = "processed" | "ignored" | "failed";

export const COACH_APP_ACCESS_PAYMENT_PURPOSE =
  "trader_intelligence_coach_app_access";

