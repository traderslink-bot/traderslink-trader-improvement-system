export function buildTraderIntelligenceVisualQaChecklist(
  routes = buildTraderIntelligenceRouteRegistry(),
): TraderIntelligenceVisualQaItem[] {
  const routeTargets = routes.filter(
    (route) => route.audience !== "debug" && route.implemented,
  );

  return routeTargets.flatMap((route) =>
    (["desktop", "mobile"] as const).map((viewport) => ({
      id: `visual:${route.routeId}:${viewport}`,
      route: route.standalonePath,
      viewport,
      status: "pending" as const,
      checklist: [
        "No export controls are visible.",
        "Text fits within cards and controls.",
        "Primary workflow action is understandable.",
        "Route works with demo platform context.",
      ],
    })),
  );
}

