import {
  parseBrokerExecutionCsv,
  type BrokerExecutionCsvFormat,
} from "../../execution-sources/csv";
import { buildProductWorkflowShellViewModel } from "./product-workflow";

export type TraderIntelligencePlatformRole =
  | "owner"
  | "member"
  | "admin"
  | "support";

export type TraderIntelligencePlanTier =
  | "demo"
  | "starter"
  | "pro"
  | "elite"
  | "internal";

export type TraderIntelligencePlatformEnvironment =
  | "standalone_demo"
  | "mounted_platform";

export type TraderIntelligenceFeatureKey =
  | "analytics_dashboard"
  | "csv_imports"
  | "guided_review"
  | "progress"
  | "trade_replay"
  | "import_health"
  | "broker_mapping_admin"
  | "account_plan"
  | "market_context"
  | "debug_routes";

export interface TraderIntelligenceEntitlements {
  canViewAnalytics: boolean;
  canImportCsv: boolean;
  canUseGuidedReview: boolean;
  canViewProgress: boolean;
  canReplayTrades: boolean;
  canViewImportHealth: boolean;
  canUseBrokerMappingAdmin: boolean;
  canViewAccountPlan: boolean;
  canUseMarketContext: boolean;
  canUseDebugRoutes: boolean;
  monthlyImportLimit: number;
  savedTradeLimit: number;
  activeRuleLimit: number;
  marketContextMode: "none" | "observational" | "calibrated_add_on";
}

export interface TraderIntelligencePlatformContext {
  contractVersion: "trader_intelligence_platform_context_v1";
  platformUserId: string;
  workspaceId: string;
  accountId: string;
  role: TraderIntelligencePlatformRole;
  planTier: TraderIntelligencePlanTier;
  entitlements: TraderIntelligenceEntitlements;
  moduleMountPath: string;
  environment: TraderIntelligencePlatformEnvironment;
  demoMode: boolean;
  generatedAt: string;
}

export type TraderIntelligenceFeatureGateState =
  | "available"
  | "locked"
  | "usage_limited"
  | "admin_only"
  | "hidden";

export interface TraderIntelligenceFeatureUsage {
  current: number;
  limit: number;
  label: string;
}

export interface TraderIntelligenceFeatureGateDecision {
  featureKey: TraderIntelligenceFeatureKey;
  allowed: boolean;
  state: TraderIntelligenceFeatureGateState;
  reason: string;
  upgradeHint: string | null;
  usage: TraderIntelligenceFeatureUsage | null;
}

export type TraderIntelligenceRouteAudience =
  | "end_user"
  | "admin"
  | "debug";

export type TraderIntelligenceRouteNavGroup =
  | "core"
  | "workflow"
  | "health"
  | "account"
  | "admin"
  | "debug";

export interface TraderIntelligenceRouteDefinition {
  routeId: string;
  label: string;
  standalonePath: string;
  platformPath: string;
  navGroup: TraderIntelligenceRouteNavGroup;
  audience: TraderIntelligenceRouteAudience;
  featureKey: TraderIntelligenceFeatureKey;
  implemented: boolean;
  requiresAdmin: boolean;
  allowsRawJson: boolean;
  allowsExport: false;
}

export interface TraderIntelligenceRouteAccess {
  route: TraderIntelligenceRouteDefinition;
  gate: TraderIntelligenceFeatureGateDecision;
  visibleInNavigation: boolean;
}

export interface TraderIntelligenceNoExportAudit {
  passed: boolean;
  endUserExportViolations: string[];
  endUserRawJsonViolations: string[];
  missingImplementedRoutePolicies: string[];
}

export type TraderIntelligenceChecklistStatus =
  | "complete"
  | "partial"
  | "blocked";

export interface TraderIntelligenceReadinessChecklistItem {
  id: string;
  label: string;
  status: TraderIntelligenceChecklistStatus;
  detail: string;
  nextAction: string;
}

export type TraderIntelligenceVisualQaStatus =
  | "pending"
  | "passed"
  | "needs_review";

export interface TraderIntelligenceVisualQaItem {
  id: string;
  route: string;
  viewport: "desktop" | "mobile";
  status: TraderIntelligenceVisualQaStatus;
  checklist: string[];
}

export interface BrokerCsvRegressionFixtureExpectation {
  fixtureFile: string;
  broker: BrokerExecutionCsvFormat;
  expectedAcceptedExecutions: number;
  expectedGroupedTrades: number;
  expectedQualityStatus: "high_confidence" | "needs_review" | "blocked";
}

export interface BrokerCsvRegressionFixtureResult
  extends BrokerCsvRegressionFixtureExpectation {
  parsedAcceptedExecutions: number;
  parsedGroupedTrades: number;
  passed: boolean;
  notes: string[];
}

export interface BrokerCsvRegressionFixtureHarness {
  totalCount: number;
  passedCount: number;
  failedCount: number;
  results: BrokerCsvRegressionFixtureResult[];
}

export interface TraderIntelligenceModuleReadinessViewModel {
  context: TraderIntelligencePlatformContext;
  workflow: ReturnType<typeof buildProductWorkflowShellViewModel>;
  routes: TraderIntelligenceRouteAccess[];
  noExportAudit: TraderIntelligenceNoExportAudit;
  readinessChecklist: TraderIntelligenceReadinessChecklistItem[];
  visualQaChecklist: TraderIntelligenceVisualQaItem[];
  brokerFixtureHarness: BrokerCsvRegressionFixtureHarness;
  routeSmokeTargets: string[];
  summary: string;
}

const DEMO_GENERATED_AT = "2026-05-03T16:00:00.000Z";

export function buildTraderIntelligenceEntitlements(
  tier: TraderIntelligencePlanTier,
): TraderIntelligenceEntitlements {
  switch (tier) {
    case "starter":
      return {
        canViewAnalytics: true,
        canImportCsv: true,
        canUseGuidedReview: true,
        canViewProgress: true,
        canReplayTrades: true,
        canViewImportHealth: false,
        canUseBrokerMappingAdmin: false,
        canViewAccountPlan: true,
        canUseMarketContext: false,
        canUseDebugRoutes: false,
        monthlyImportLimit: 5,
        savedTradeLimit: 250,
        activeRuleLimit: 3,
        marketContextMode: "none",
      };
    case "pro":
    case "demo":
      return {
        canViewAnalytics: true,
        canImportCsv: true,
        canUseGuidedReview: true,
        canViewProgress: true,
        canReplayTrades: true,
        canViewImportHealth: true,
        canUseBrokerMappingAdmin: false,
        canViewAccountPlan: true,
        canUseMarketContext: true,
        canUseDebugRoutes: false,
        monthlyImportLimit: 50,
        savedTradeLimit: 5000,
        activeRuleLimit: 20,
        marketContextMode: "observational",
      };
    case "elite":
      return {
        canViewAnalytics: true,
        canImportCsv: true,
        canUseGuidedReview: true,
        canViewProgress: true,
        canReplayTrades: true,
        canViewImportHealth: true,
        canUseBrokerMappingAdmin: false,
        canViewAccountPlan: true,
        canUseMarketContext: true,
        canUseDebugRoutes: false,
        monthlyImportLimit: 100,
        savedTradeLimit: 25000,
        activeRuleLimit: 50,
        marketContextMode: "calibrated_add_on",
      };
    case "internal":
      return {
        canViewAnalytics: true,
        canImportCsv: true,
        canUseGuidedReview: true,
        canViewProgress: true,
        canReplayTrades: true,
        canViewImportHealth: true,
        canUseBrokerMappingAdmin: true,
        canViewAccountPlan: true,
        canUseMarketContext: true,
        canUseDebugRoutes: true,
        monthlyImportLimit: 9999,
        savedTradeLimit: 999999,
        activeRuleLimit: 9999,
        marketContextMode: "calibrated_add_on",
      };
  }
}

export function buildDemoTraderIntelligencePlatformContext(args?: {
  role?: TraderIntelligencePlatformRole;
  planTier?: TraderIntelligencePlanTier;
  moduleMountPath?: string;
  environment?: TraderIntelligencePlatformEnvironment;
}): TraderIntelligencePlatformContext {
  const role = args?.role ?? "owner";
  const planTier = args?.planTier ?? "pro";

  return {
    contractVersion: "trader_intelligence_platform_context_v1",
    platformUserId: "demo-platform-user",
    workspaceId: "demo-workspace",
    accountId: "demo-trading-account",
    role,
    planTier,
    entitlements: buildTraderIntelligenceEntitlements(planTier),
    moduleMountPath: args?.moduleMountPath ?? "/dashboard/trader-intelligence",
    environment: args?.environment ?? "standalone_demo",
    demoMode: true,
    generatedAt: DEMO_GENERATED_AT,
  };
}

function isAdminRole(role: TraderIntelligencePlatformRole): boolean {
  return role === "admin" || role === "support";
}

function entitlementAllowed(
  context: TraderIntelligencePlatformContext,
  featureKey: TraderIntelligenceFeatureKey,
): boolean {
  const entitlements = context.entitlements;

  switch (featureKey) {
    case "analytics_dashboard":
      return entitlements.canViewAnalytics;
    case "csv_imports":
      return entitlements.canImportCsv;
    case "guided_review":
      return entitlements.canUseGuidedReview;
    case "progress":
      return entitlements.canViewProgress;
    case "trade_replay":
      return entitlements.canReplayTrades;
    case "import_health":
      return entitlements.canViewImportHealth;
    case "broker_mapping_admin":
      return entitlements.canUseBrokerMappingAdmin && isAdminRole(context.role);
    case "account_plan":
      return entitlements.canViewAccountPlan;
    case "market_context":
      return entitlements.canUseMarketContext;
    case "debug_routes":
      return entitlements.canUseDebugRoutes && isAdminRole(context.role);
  }
}

function usageForFeature(args: {
  context: TraderIntelligencePlatformContext;
  featureKey: TraderIntelligenceFeatureKey;
  usage?: Partial<Record<TraderIntelligenceFeatureKey, number>>;
}): TraderIntelligenceFeatureUsage | null {
  const current = args.usage?.[args.featureKey];
  if (typeof current !== "number") {
    return null;
  }

  switch (args.featureKey) {
    case "csv_imports":
      return {
        current,
        limit: args.context.entitlements.monthlyImportLimit,
        label: "monthly imports",
      };
    case "analytics_dashboard":
    case "trade_replay":
      return {
        current,
        limit: args.context.entitlements.savedTradeLimit,
        label: "saved trades",
      };
    default:
      return null;
  }
}

export function evaluateTraderIntelligenceFeatureGate(args: {
  context: TraderIntelligencePlatformContext;
  featureKey: TraderIntelligenceFeatureKey;
  usage?: Partial<Record<TraderIntelligenceFeatureKey, number>>;
}): TraderIntelligenceFeatureGateDecision {
  const usage = usageForFeature(args);

  if (
    (args.featureKey === "broker_mapping_admin" ||
      args.featureKey === "debug_routes") &&
    !isAdminRole(args.context.role)
  ) {
    return {
      featureKey: args.featureKey,
      allowed: false,
      state: "admin_only",
      reason: "This feature is reserved for platform admin/support roles.",
      upgradeHint: null,
      usage,
    };
  }

  if (!entitlementAllowed(args.context, args.featureKey)) {
    return {
      featureKey: args.featureKey,
      allowed: false,
      state: "locked",
      reason: "The current plan does not include this feature.",
      upgradeHint: "Use the platform plan system to unlock this module feature later.",
      usage,
    };
  }

  if (usage && usage.current >= usage.limit) {
    return {
      featureKey: args.featureKey,
      allowed: false,
      state: "usage_limited",
      reason: `${usage.label} limit reached.`,
      upgradeHint: "Increase the plan limit in the platform billing layer later.",
      usage,
    };
  }

  return {
    featureKey: args.featureKey,
    allowed: true,
    state: "available",
    reason: "Feature is available in the current demo platform context.",
    upgradeHint: null,
    usage,
  };
}

