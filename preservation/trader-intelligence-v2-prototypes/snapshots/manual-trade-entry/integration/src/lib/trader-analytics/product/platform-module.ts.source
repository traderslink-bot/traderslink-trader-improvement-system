    expectedQualityStatus: "high_confidence",
  },
  {
    fixtureFile: "thinkorswim-account-statement-sample.csv",
    broker: "generic_execution_csv",
    expectedAcceptedExecutions: 2,
    expectedGroupedTrades: 1,
    expectedQualityStatus: "high_confidence",
  },
];

export function getBrokerCsvRegressionFixtureExpectations(): BrokerCsvRegressionFixtureExpectation[] {
  return BROKER_FIXTURE_EXPECTATIONS;
}

export function buildBrokerCsvRegressionFixtureHarness(args: {
  fixtureContentsByFile: Record<string, string>;
  expectations?: BrokerCsvRegressionFixtureExpectation[];
}): BrokerCsvRegressionFixtureHarness {
  const expectations = args.expectations ?? BROKER_FIXTURE_EXPECTATIONS;
  const results = expectations.map((expectation) => {
    const csvText = args.fixtureContentsByFile[expectation.fixtureFile];

    if (!csvText) {
      return {
        ...expectation,
        parsedAcceptedExecutions: 0,
        parsedGroupedTrades: 0,
        passed: false,
        notes: ["Sample content was not provided."],
      };
    }

    const result = parseBrokerExecutionCsv({
      broker: expectation.broker,
      csvText,
      timestampTimezone: "America/New_York",
    });
    const passed =
      result.acceptedExecutionCount === expectation.expectedAcceptedExecutions &&
      result.requestCount === expectation.expectedGroupedTrades;

    return {
      ...expectation,
      parsedAcceptedExecutions: result.acceptedExecutionCount,
      parsedGroupedTrades: result.requestCount,
      passed,
      notes: passed
        ? ["Sample parsed as expected."]
        : [
            `Expected ${expectation.expectedAcceptedExecutions} executions and ${expectation.expectedGroupedTrades} grouped trade(s).`,
          ],
    };
  });

  return {
    totalCount: results.length,
    passedCount: results.filter((result) => result.passed).length,
    failedCount: results.filter((result) => !result.passed).length,
    results,
  };
}

export function buildTraderIntelligenceModuleReadinessViewModel(args?: {
  context?: TraderIntelligencePlatformContext;
  fixtureContentsByFile?: Record<string, string>;
}): TraderIntelligenceModuleReadinessViewModel {
  const context = args?.context ?? buildDemoTraderIntelligencePlatformContext();
  const workflow = buildProductWorkflowShellViewModel();
  const usage: Partial<Record<TraderIntelligenceFeatureKey, number>> = {
    csv_imports: workflow.accountPlan.currentUsage.importsThisMonth,
    analytics_dashboard: workflow.accountPlan.currentUsage.savedTradeCount,
    trade_replay: workflow.accountPlan.currentUsage.savedTradeCount,
  };
  const routes = buildTraderIntelligenceRouteAccess({ context, usage });
  const routeDefinitions = routes.map((route) => route.route);
  const noExportAudit = auditTraderIntelligenceNoExportPolicy({
    routes: routeDefinitions,
  });
  const brokerFixtureHarness = buildBrokerCsvRegressionFixtureHarness({
    fixtureContentsByFile: args?.fixtureContentsByFile ?? {},
  });
  const routeSmokeTargets = [
    "/",
    "/platform-readiness",
    ...routeDefinitions
      .filter(
        (route) =>
          route.implemented &&
          route.audience !== "debug" &&
          route.standalonePath !== "/trades/[tradeId]",
      )
      .map((route) => route.standalonePath),
    "/trades/trade-rapid-fire",
  ];

  return {
    context,
    workflow,
    routes,
    noExportAudit,
    readinessChecklist: buildTraderIntelligenceFeatureReadinessChecklist(),
    visualQaChecklist: buildTraderIntelligenceVisualQaChecklist(routeDefinitions),
    brokerFixtureHarness,
    routeSmokeTargets,
    summary: noExportAudit.passed
      ? "Trader Intelligence is platform-ready in demo module mode."
      : "Trader Intelligence has platform-readiness policy issues to fix.",
  };
}
