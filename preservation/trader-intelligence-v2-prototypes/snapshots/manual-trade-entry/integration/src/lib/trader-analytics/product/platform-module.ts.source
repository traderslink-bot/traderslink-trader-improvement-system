function platformPathFor(
  mountPath: string,
  standalonePath: string,
): string {
  const normalizedMount = mountPath.endsWith("/")
    ? mountPath.slice(0, -1)
    : mountPath;

  if (standalonePath === "/analytics") {
    return normalizedMount;
  }

  return `${normalizedMount}${standalonePath}`;
}

export function buildTraderIntelligenceRouteRegistry(
  context = buildDemoTraderIntelligencePlatformContext(),
): TraderIntelligenceRouteDefinition[] {
  return ROUTES.map((route) => ({
    ...route,
    platformPath: platformPathFor(context.moduleMountPath, route.standalonePath),
  }));
}

export function buildTraderIntelligenceRouteAccess(args: {
  context: TraderIntelligencePlatformContext;
  usage?: Partial<Record<TraderIntelligenceFeatureKey, number>>;
}): TraderIntelligenceRouteAccess[] {
  return buildTraderIntelligenceRouteRegistry(args.context).map((route) => {
    const gate = evaluateTraderIntelligenceFeatureGate({
      context: args.context,
      featureKey: route.featureKey,
      usage: args.usage,
    });

    return {
      route,
      gate,
      visibleInNavigation:
        route.implemented &&
        gate.allowed &&
        route.audience !== "debug" &&
        (!route.requiresAdmin || isAdminRole(args.context.role)),
    };
  });
}

export function auditTraderIntelligenceNoExportPolicy(args: {
  routes: TraderIntelligenceRouteDefinition[];
  implementedStandalonePaths?: string[];
}): TraderIntelligenceNoExportAudit {
  const implementedStandalonePaths = args.implementedStandalonePaths ?? [
    "/analytics",
    "/imports",
    "/import-dry-run",
    "/import-trials",
    "/repair-wizard",
    "/review-cockpit",
    "/review",
    "/progress",
    "/calibration",
    "/import-health",
    "/admin/broker-mappings",
    "/account",
    "/trades/[tradeId]",
  ];
  const routePaths = new Set(args.routes.map((route) => route.standalonePath));

  return {
    passed:
      args.routes.every(
        (route) =>
          !route.allowsExport &&
          (route.audience !== "end_user" || !route.allowsRawJson),
      ) &&
      implementedStandalonePaths.every((path) => routePaths.has(path)),
    endUserExportViolations: args.routes
      .filter((route) => route.audience === "end_user" && route.allowsExport)
      .map((route) => route.standalonePath),
    endUserRawJsonViolations: args.routes
      .filter((route) => route.audience === "end_user" && route.allowsRawJson)
      .map((route) => route.standalonePath),
    missingImplementedRoutePolicies: implementedStandalonePaths.filter(
      (path) => !routePaths.has(path),
    ),
  };
}

