import type { Metadata } from "next";
import Link from "next/link";
import {
  readTraderPeriodReflectionUsageReport,
  type TraderPeriodReflectionUsageKindRow,
  type TraderPeriodReflectionUsageModelRow,
} from "../../../src/lib/trader-analytics/server/period-reflection-usage-report";

export const metadata: Metadata = {
  title: "AI Reflection Usage | Trader Intelligence",
};

export const runtime = "nodejs";
export const dynamic = "force-dynamic";

function formatUsd(value: number | null): string {
  if (value === null) {
    return "unknown";
  }

  if (value < 0.01 && value > 0) {
    return `$${value.toFixed(6)}`;
  }

  return new Intl.NumberFormat("en-US", {
    currency: "USD",
    maximumFractionDigits: 2,
    minimumFractionDigits: 2,
    style: "currency",
  }).format(value);
}

function formatNumber(value: number): string {
  return new Intl.NumberFormat("en-US").format(value);
}

function formatDateTime(value: string): string {
  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return value;
  }

  return date.toLocaleString("en-US", {
    dateStyle: "medium",
    timeStyle: "short",
  });
}

function summaryMetric(args: {
  detail: string;
  label: string;
  value: string;
}) {
  return (
    <div className="border border-zinc-800 bg-zinc-950 p-4">
      <div className="text-xs font-semibold uppercase tracking-wide text-zinc-500">
        {args.label}
      </div>
      <div className="mt-2 text-2xl font-semibold text-zinc-50">
        {args.value}
      </div>
      <div className="mt-1 text-sm leading-6 text-zinc-500">{args.detail}</div>
    </div>
  );
}

function modelRowCost(
  row: TraderPeriodReflectionUsageModelRow | TraderPeriodReflectionUsageKindRow,
): string {
  return formatUsd(row.estimatedCostUsd);
}

