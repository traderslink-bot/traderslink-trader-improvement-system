import Link from "next/link";
import type {
  TraderPeriodReflection,
  TraderPeriodReflectionGenerationAvailability,
  TraderPeriodReflectionKind,
  TraderPeriodReflectionSystem,
} from "../src/lib/trader-analytics/product/types";
import { PeriodReflectionRegenerateButton } from "./period-reflection-regenerate-button";

function signed(value: number): string {
  return `${value >= 0 ? "+" : ""}${value.toFixed(2)}`;
}

function kindTone(kind: TraderPeriodReflectionKind): string {
  switch (kind) {
    case "daily":
      return "border-sky-800/80 bg-sky-950/25 text-sky-200";
    case "weekly":
      return "border-emerald-900/80 bg-emerald-950/20 text-emerald-200";
    case "monthly":
      return "border-amber-900/80 bg-amber-950/20 text-amber-100";
  }
}

function compactEvidenceDetail(detail: string): string {
  const maxLength = 170;
  const cleanDetail = detail
    .replace(/\bimport:broker-csv-file-v1-[a-z0-9:-]+/gi, "a saved import")
    .replace(/\bImport a saved import\b/g, "a saved import");

  if (cleanDetail.length <= maxLength) {
    return cleanDetail;
  }

  return `${cleanDetail.slice(0, maxLength - 1).trimEnd()}...`;
}

function dailySessionEvidence(
  reflection: TraderPeriodReflection,
): TraderPeriodReflection["evidence"] {
  if (reflection.kind !== "daily") {
    return [];
  }

  return reflection.evidence
    .filter((item) => item.id === "daily:session-story" || item.id.startsWith("daily:session-"))
    .slice(0, 3);
}

function reviewEvidence(
  reflection: TraderPeriodReflection,
): TraderPeriodReflection["evidence"] {
  return reflection.evidence
    .filter((item) =>
      ["comparison", "note", "risk", "rule", "strength"].includes(item.kind),
    )
    .slice(0, 4);
}

function reviewTitle(kind: TraderPeriodReflectionKind): string {
  switch (kind) {
    case "daily":
      return "Daily Journal Prompt";
    case "weekly":
      return "End Of Week Review";
    case "monthly":
      return "End Of Month Review";
  }
}

function reviewIntro(kind: TraderPeriodReflectionKind): string {
  switch (kind) {
    case "daily":
      return "Use the day replay and notes to name what changed during the session.";
    case "weekly":
      return "Evaluate the full trading week: what repeated, what improved, what got worse, and what rule should guide next week.";
    case "monthly":
      return "Look across the month and weekly memories to decide whether the trader improved or repeated the same behavior.";
  }
}

function ReflectionCard({
  availability,
  canRegenerate,
  reflection,
}: {
  availability: TraderPeriodReflectionGenerationAvailability;
  canRegenerate: boolean;
  reflection: TraderPeriodReflection;
}) {
  const firstTradeId = reflection.relatedTradeIds[0] ?? null;
  const sessionEvidence = dailySessionEvidence(reflection);
  const isDaily = reflection.kind === "daily";

  return (
    <article
      className="ti-panel-soft flex min-h-[320px] flex-col justify-between p-4"
      data-testid={`period-reflection-${reflection.kind}`}
    >
      <div>
        <div className="flex items-start justify-between gap-3">
          <div>
            <p className="text-xs font-semibold uppercase tracking-wide text-zinc-500">
              {reflection.title}
            </p>
            <h3 className="mt-2 text-lg font-semibold text-zinc-50">
              {reflection.label}
            </h3>
          </div>
          <span
            className={`shrink-0 rounded-md border px-2.5 py-1 text-xs font-semibold ${kindTone(
              reflection.kind,
            )}`}
          >
            {signed(reflection.grossTotalRealizedPnl)}
          </span>
        </div>
        {canRegenerate ? (
          <div className="mt-4">
            <PeriodReflectionRegenerateButton
              availability={availability}
              kind={reflection.kind}
            />
          </div>
        ) : null}

        <p className="mt-4 text-sm font-semibold leading-6 text-zinc-100">
          {reflection.headline}
        </p>
        <p className="mt-3 text-sm leading-6 text-zinc-400">
          {reflection.summary}
        </p>

        {sessionEvidence.length > 0 ? (
          <div className="mt-4 rounded-md border border-amber-900/70 bg-amber-950/20 p-3">
            <div className="text-[11px] font-semibold uppercase tracking-wide text-amber-300">
              Evidence checked
            </div>
            <div className="mt-2 grid gap-2">
              {sessionEvidence.map((item) => (
                <p className="text-xs leading-5 text-zinc-400" key={item.id}>
                  <span className="font-semibold text-zinc-200">
                    {item.label}
                  </span>
                  : {compactEvidenceDetail(item.detail)}
                </p>
              ))}
            </div>
          </div>
        ) : null}

        {isDaily ? null : (
          <div className="mt-4 grid gap-3">
            <div className="rounded-md border border-zinc-800/80 bg-zinc-950/35 p-3">
              <div className="text-[11px] font-semibold uppercase tracking-wide text-emerald-300">
                Preserve
              </div>
              <p className="mt-1 text-xs leading-5 text-zinc-400">
                {reflection.whatWentWell}
              </p>
            </div>
            <div className="rounded-md border border-zinc-800/80 bg-zinc-950/35 p-3">
              <div className="text-[11px] font-semibold uppercase tracking-wide text-amber-300">
                Improve
              </div>
              <p className="mt-1 text-xs leading-5 text-zinc-400">
                {reflection.whatNeedsWork}
              </p>
            </div>
            <div className="rounded-md border border-zinc-800/80 bg-zinc-950/35 p-3">
              <div className="text-[11px] font-semibold uppercase tracking-wide text-sky-300">
                Notes
              </div>
              <p className="mt-1 text-xs leading-5 text-zinc-400">
                {reflection.noteInsight}
              </p>
            </div>
          </div>
        )}
      </div>

      <div className="mt-5 border-t border-zinc-900 pt-4">
        <div className="text-xs font-semibold uppercase tracking-wide text-zinc-500">
          {isDaily ? "Open the day" : "Next focus"}
        </div>
        <p className="mt-2 text-sm leading-6 text-zinc-300">
          {reflection.nextFocus}
        </p>
        <div className="mt-4 flex flex-wrap items-center gap-3 text-xs">
          <span className="text-zinc-500">
            {reflection.tradeCount} trade{reflection.tradeCount === 1 ? "" : "s"} /{" "}
            {reflection.noteCount} note{reflection.noteCount === 1 ? "" : "s"}
          </span>
          {isDaily ? (
            <Link
              className="font-semibold text-sky-300 underline-offset-4 hover:underline"
              href={`/trades/day-session/${encodeURIComponent(reflection.startDate)}#day-notes`}
            >
              Open day notes
            </Link>
          ) : firstTradeId ? (
            <Link
              className="font-semibold text-sky-300 underline-offset-4 hover:underline"
              href={`/trades/${encodeURIComponent(firstTradeId)}#writing-flow`}
            >
              Open example trade
            </Link>
          ) : null}
        </div>
      </div>
    </article>
  );
}

function EndPeriodReview({
  availability,
  canRegenerate,
  reflection,
}: {
  availability: TraderPeriodReflectionGenerationAvailability;
  canRegenerate: boolean;
  reflection: TraderPeriodReflection;
}) {
  const evidence = reviewEvidence(reflection);
  const firstTradeId = reflection.relatedTradeIds[0] ?? null;

  return (
    <section
      className="rounded-md border border-zinc-800 bg-zinc-950/30 p-4"
      data-testid={`end-period-review-${reflection.kind}`}
    >
      <div className="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
        <div>
          <p className="text-xs font-semibold uppercase tracking-wide text-sky-300">
            {reviewTitle(reflection.kind)}
          </p>
          <h3 className="mt-2 text-lg font-semibold text-zinc-50">
            {reflection.label}
          </h3>
          <p className="mt-2 max-w-4xl text-sm leading-6 text-zinc-400">
            {reviewIntro(reflection.kind)}
          </p>
        </div>
        <div className="flex flex-col items-start gap-2 lg:items-end">
          <span
            className={`rounded-md border px-2.5 py-1 text-xs font-semibold ${kindTone(
              reflection.kind,
            )}`}
          >
            {reflection.tradeCount} trade{reflection.tradeCount === 1 ? "" : "s"} /{" "}
            {reflection.noteCount} note{reflection.noteCount === 1 ? "" : "s"}
          </span>
          {canRegenerate ? (
            <PeriodReflectionRegenerateButton
              availability={availability}
              kind={reflection.kind}
            />
          ) : null}
        </div>
      </div>

      <div className="mt-5 grid gap-4 xl:grid-cols-[minmax(0,1.2fr)_minmax(280px,0.8fr)]">
        <div className="grid gap-3">
          <div>
            <div className="text-xs font-semibold uppercase tracking-wide text-zinc-500">
              What to understand
            </div>
            <p className="mt-2 text-sm font-semibold leading-6 text-zinc-100">
              {reflection.headline}
            </p>
            <p className="mt-2 text-sm leading-6 text-zinc-400">
              {reflection.summary}
            </p>
          </div>

          <div className="grid gap-3 md:grid-cols-2">
            <div className="rounded-md border border-emerald-900/70 bg-emerald-950/15 p-3">
              <div className="text-[11px] font-semibold uppercase tracking-wide text-emerald-300">
                Keep doing
              </div>
              <p className="mt-2 text-xs leading-5 text-zinc-300">
                {reflection.whatWentWell}
              </p>
            </div>
            <div className="rounded-md border border-amber-900/70 bg-amber-950/15 p-3">
              <div className="text-[11px] font-semibold uppercase tracking-wide text-amber-300">
                Improve next
              </div>
              <p className="mt-2 text-xs leading-5 text-zinc-300">
                {reflection.whatNeedsWork}
              </p>
            </div>
          </div>

          <div className="rounded-md border border-sky-900/70 bg-sky-950/15 p-3">
            <div className="text-[11px] font-semibold uppercase tracking-wide text-sky-300">
              Notes and progress
            </div>
            <p className="mt-2 text-xs leading-5 text-zinc-300">
              {reflection.noteInsight}
            </p>
            <p className="mt-2 text-xs leading-5 text-zinc-400">
              {reflection.progressInsight}
            </p>
          </div>
        </div>

        <div className="grid content-start gap-3">
          <div className="rounded-md border border-zinc-800 bg-zinc-950/40 p-3">
            <div className="text-[11px] font-semibold uppercase tracking-wide text-zinc-500">
              Next rule to test
            </div>
            <p className="mt-2 text-sm leading-6 text-zinc-200">
              {reflection.nextFocus}
            </p>
            {firstTradeId ? (
              <Link
                className="mt-3 inline-flex text-xs font-semibold text-sky-300 underline-offset-4 hover:underline"
                href={`/trades/${encodeURIComponent(firstTradeId)}#writing-flow`}
            >
                Open an example trade
              </Link>
            ) : null}
          </div>

          {evidence.length > 0 ? (
            <div className="rounded-md border border-zinc-800 bg-zinc-950/40 p-3">
              <div className="text-[11px] font-semibold uppercase tracking-wide text-zinc-500">
                Evidence used
              </div>
              <div className="mt-2 grid gap-2">
                {evidence.map((item) => (
                  <p className="text-xs leading-5 text-zinc-400" key={item.id}>
                    <span className="font-semibold text-zinc-200">
                      {item.label}
                    </span>
                    : {compactEvidenceDetail(item.detail)}
                  </p>
                ))}
              </div>
            </div>
          ) : null}
        </div>
      </div>
    </section>
  );
}

export function PeriodReflectionPanel({
  canRegenerate = false,
  reflections,
  title = "Trading Reflections",
}: {
  canRegenerate?: boolean;
  reflections: TraderPeriodReflectionSystem;
  title?: string;
}) {
  return (
    <section
      className="ti-panel p-5"
      data-testid="trader-period-reflection-system"
      id="trading-reflections"
    >
      <div className="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
        <div>
          <p className="text-xs font-semibold uppercase tracking-wide text-sky-300">
            Reflection Loop
          </p>
          <h2 className="mt-2 text-xl font-semibold text-zinc-50">{title}</h2>
          <p className="mt-2 max-w-4xl text-sm leading-6 text-zinc-400">
            Daily notes, weekly coaching, and monthly progress from saved
            executions and written trade notes.
          </p>
        </div>
        <div className="flex flex-col gap-3 sm:flex-row sm:items-start">
          <div className="rounded-md border border-zinc-800 bg-zinc-950/50 px-3 py-2 text-xs leading-5 text-zinc-400">
            {reflections.policy.evidenceFirst
              ? "Evidence-first summaries"
              : "Summary policy pending"}
          </div>
        </div>
      </div>

      <div className="mt-5 grid gap-4 2xl:grid-cols-3">
        <ReflectionCard
          availability={reflections.generation.daily}
          canRegenerate={canRegenerate}
          reflection={reflections.daily}
        />
        <ReflectionCard
          availability={reflections.generation.weekly}
          canRegenerate={canRegenerate}
          reflection={reflections.weekly}
        />
        <ReflectionCard
          availability={reflections.generation.monthly}
          canRegenerate={canRegenerate}
          reflection={reflections.monthly}
        />
      </div>

      <div className="mt-5 grid gap-4">
        <EndPeriodReview
          availability={reflections.generation.weekly}
          canRegenerate={canRegenerate}
          reflection={reflections.weekly}
        />
        <EndPeriodReview
          availability={reflections.generation.monthly}
          canRegenerate={canRegenerate}
          reflection={reflections.monthly}
        />
      </div>
    </section>
  );
}
