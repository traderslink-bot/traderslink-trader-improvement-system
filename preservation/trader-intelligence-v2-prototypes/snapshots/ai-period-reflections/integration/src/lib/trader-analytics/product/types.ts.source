import type { UserTradeAnalysisRequest } from "../../trade-analysis/request/trade-analysis-request-contract";
import type {
  SessionBucket,
  SessionExposureSegment,
} from "../../raw-trade-timeline/types/session-context";
import type {
  BrokerExecutionCsvCanonicalField,
  BrokerExecutionCsvColumnMapping,
  BrokerExecutionCsvImportIssueCode,
  BrokerExecutionCsvImportResult,
  BrokerExecutionCsvMappingConfidenceLevel,
  BrokerExecutionCsvTradeGroupingDiagnostic,
  BrokerExecutionCsvFormat,
  BrokerExecutionCsvOptionsHandling,
} from "../../execution-sources/csv";
import type { ExecutionFeedbackSummary } from "../../execution-feedback/summary/build-execution-feedback-summary";
import type {
  TraderAnalyticsPointCategory,
  TraderAnalyticsPointDigest,
  TraderAnalyticsReport,
  TraderAnalyticsTradeRow,
} from "../types/trader-analytics-report";

export type TraderAnalyticsUserId = string;
export type TraderAnalyticsAccountId = string;
export type SavedExecutionTradeId = string;
export type SavedTraderAnalyticsReportId = string;
export type SavedTraderRuleId = string;
export type SavedTraderRuleTemplateId = string;
export type SavedTradeImportBatchId = string;
export type TraderWorkspaceId = string;
export type TraderProductUserRole = "owner" | "member" | "admin" | "support";

export type SavedReviewStatus =
  | "new"
  | "reviewed"
  | "in_progress"
  | "resolved"
  | "ignored";

export interface SavedReportNote {
  id: string;
  createdAt: string;
  body: string;
}

export interface SavedSessionNote extends SavedReportNote {
  accountId: TraderAnalyticsAccountId;
  sessionDate: string;
  userId: TraderAnalyticsUserId;
}

export interface SavedReportPeriod {
  startDate: string;
  endDate: string;
  label: string;
}

export interface SavedExecutionTrade {
  id: SavedExecutionTradeId;
  userId: TraderAnalyticsUserId;
  accountId: TraderAnalyticsAccountId;
  importedAt: string;
  importBatchId?: SavedTradeImportBatchId;
  repairSource?: "original_csv" | "repaired_csv";
  sourceLabel: string;
  sampleData: boolean;
  symbol: string;
  tradeDirection: string;
  sessionDate: string;
  sessionBucket: string;
  entrySessionBucket?: SessionBucket | string;
  entrySessionDateEt?: string;
  entryTimeEt?: string;
  entryHourEt?: number | null;
  entryHourLabelEt?: string;
  sessionExposure?: SessionExposureSegment[];
  heldSessionBuckets?: Array<SessionBucket | string>;
  heldHourBucketsEt?: string[];
  request: UserTradeAnalysisRequest;
  reviewStatus: SavedReviewStatus;
  notes: SavedReportNote[];
}

export interface SavedTraderAnalyticsSummaryRef {
  tradeId: SavedExecutionTradeId;
  requestIndex: number;
  summary: ExecutionFeedbackSummary;
}

export interface SavedTraderAnalyticsReport {
  id: SavedTraderAnalyticsReportId;
  userId: TraderAnalyticsUserId;
  accountId: TraderAnalyticsAccountId;
  generatedAt: string;
  reportPeriod: SavedReportPeriod;
  sourceTradeIds: SavedExecutionTradeId[];
  sourceSummaries: SavedTraderAnalyticsSummaryRef[];
  report: TraderAnalyticsReport;
  reviewStatus: SavedReviewStatus;
  notes: SavedReportNote[];
  sampleData: boolean;
}

export interface SavedTraderAnalyticsRepository {
  listTrades(userId: TraderAnalyticsUserId): SavedExecutionTrade[];
  getTrade(
    userId: TraderAnalyticsUserId,
    tradeId: SavedExecutionTradeId,
  ): SavedExecutionTrade | null;
  saveTrade(trade: SavedExecutionTrade): void;
  listReports(userId: TraderAnalyticsUserId): SavedTraderAnalyticsReport[];
  getReport(
    userId: TraderAnalyticsUserId,
    reportId: SavedTraderAnalyticsReportId,
  ): SavedTraderAnalyticsReport | null;
  saveReport(report: SavedTraderAnalyticsReport): void;
  addSessionNote?(args: {
    accountId: TraderAnalyticsAccountId;
    body: string;
    createdAt?: string;
    sessionDate: string;
    userId: TraderAnalyticsUserId;
  }): SavedSessionNote | null;
  listSessionNotes?(args: {
    accountId?: TraderAnalyticsAccountId;
    sessionDate?: string;
    userId: TraderAnalyticsUserId;
  }): SavedSessionNote[];
}

export interface TraderProductUser {
  id: TraderAnalyticsUserId;
  displayName: string;
  role: TraderProductUserRole;
  sampleData: boolean;
}

export interface TraderWorkspace {
  id: TraderWorkspaceId;
  name: string;
  ownerUserId: TraderAnalyticsUserId;
  accountIds: TraderAnalyticsAccountId[];
  sampleData: boolean;
}

export interface TraderWorkspaceAccount {
  id: TraderAnalyticsAccountId;
  workspaceId: TraderWorkspaceId;
  label: string;
  brokerLabel: string;
  timezone: string;
  baseCurrency: string;
  defaultBroker: BrokerExecutionCsvFormat;
  supportedAssetClasses: TraderWorkspaceAccountAssetClass[];
  importDefaults: TraderWorkspaceAccountImportDefaults;
  commissionHandling: TraderWorkspaceAccountCommissionHandling;
  sampleData: boolean;
}

export type TraderWorkspaceAccountAssetClass = "stocks" | "options";

export type TraderWorkspaceAccountCommissionHandling =
  | "prefer_broker_net_amount"
  | "gross_minus_known_costs"
  | "gross_only";

export interface TraderWorkspaceAccountImportDefaults {
  timestampTimezone: string;
  optionsHandling: BrokerExecutionCsvOptionsHandling;
  maxTradeGroupingGapMinutes: number | null;
  splitTradesAtSessionBoundary: boolean;
}

export interface TraderWorkspaceSummary {
  workspaceId: TraderWorkspaceId;
  workspaceName: string;
  userId: TraderAnalyticsUserId;
  userRole: TraderProductUserRole;
  activeAccountId: TraderAnalyticsAccountId;
  activeAccountLabel: string;
  brokerLabel: string;
  accountTimezone: string;
  accountBaseCurrency: string;
  accountCount: number;
  sampleData: boolean;
  persistenceMode: TraderAnalyticsStorageMode;
  nextAction: string;
}

export type TraderAnalyticsStorageMode =
  | "sample_in_memory"
  | "local_sqlite_single_user"
  | "authenticated_persistent";

export interface TraderAnalyticsStorageReadinessCheck {
  id: string;
  label: string;
  passed: boolean;
  required: boolean;
}

export interface TraderAnalyticsStorageReadiness {
  mode: TraderAnalyticsStorageMode;
  label: string;
  readyForProductionPersistence: boolean;
  blockerCount: number;
  checks: TraderAnalyticsStorageReadinessCheck[];
  nextAction: string;
}

export interface TraderAnalyticsFilter {
  symbol?: string;
  tradeDirection?: string;
  sessionBucket?: string;
  entryHourEt?: number;
  outcome?: "winner" | "loser" | "flat";
  lifecycle?: "closed" | "open";
}

export interface TraderAnalyticsFilterOptions {
  symbols: string[];
  tradeDirections: string[];
  sessionBuckets: string[];
  entryHoursEt: Array<{ value: number; label: string }>;
  outcomes: Array<"winner" | "loser" | "flat">;
  lifecycles: Array<"closed" | "open">;
}

export interface ProductTraderAnalyticsTradeRow
