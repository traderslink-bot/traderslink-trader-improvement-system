  | "risk"
  | "strength"
  | "primary_focus"
  | "review_prompt"
  | "lifecycle"
  | "pnl";

export interface TraderAnalyticsDrillDown {
  id: string;
  kind: TraderAnalyticsDrillDownKind;
  label: string;
  summary: string;
  sourceMetricId: string;
  category: TraderAnalyticsPointCategory | "lifecycle" | "pnl";
  tradeIds: SavedExecutionTradeId[];
