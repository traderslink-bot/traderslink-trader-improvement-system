}

export interface TraderAnalyticsMetricDelta {
  id: string;
  label: string;
  previousValue: number | null;
  currentValue: number | null;
  delta: number | null;
  direction: "up" | "down" | "flat" | "insufficient_data";
  favorableDirection: "up" | "down" | "neutral";
}

export interface BehaviorTrendCard {
  behaviorId: string;
  label: string;
  previousRate: number | null;
  currentRate: number | null;
