  | "review"
  | "info";

export type BrokerCsvImportRepairActionKind =
  | "edit_row_field"
  | "choose_timezone"
  | "choose_options_handling"
  | "skip_row"
  | "skip_duplicate"
  | "review_broker_mapping"
  | "review_trade_grouping"
